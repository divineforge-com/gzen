---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";

const gddMeta = {
  title: "Zen Game Foundation — Game Design Document & Concept Review | gZen",
  description: "Comprehensive Game Design Document (GDD) and 3D concept review for the gZen Zen Game: slow letter transit, low-poly isometric dioramas, and Buddhist contemplative mechanics.",
};
---

<BaseLayout title={gddMeta.title} description={gddMeta.description}>
  <div class="gdd-container">
    <!-- Header / Navigation Bar -->
    <header class="gdd-nav">
      <div class="gdd-nav-inner">
        <a href="/" class="brand-link">
          <span class="brand-glyph">✦</span>
          <span class="brand-name">gZen<strong>.io</strong></span>
        </a>
        <div class="nav-actions">
          <span class="badge doc-badge">GDD-v1.0 • Living Spec</span>
          <a href="#toc" class="nav-toc-link">Table of Contents</a>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-header">
        <div class="zen-seal">ZEN-GDD</div>
        <h1 class="hero-title">Zen Game Foundation</h1>
        <p class="hero-subtitle">
          Game Design Document, Technical Architecture & Diorama Concept
        </p>
        <div class="meta-strip">
          <span><strong>Document ID:</strong> <code>ZEN-GAME-FOUNDATION-GDD-v1.0</code></span>
          <span><strong>Pillars:</strong> Slow Transit · Brahmaviharas · Edge Relay</span>
          <span><strong>Target:</strong> Web-First (R3F) &amp; Mobile (Capacitor / Godot)</span>
        </div>
      </div>

      <!-- Hero Visual Art Frame -->
      <div class="concept-showcase">
        <div class="concept-frame">
          <picture>
            <source srcset="/assets/game-design/zen-world-concept.webp" type="image/webp" />
            <img
              src="/assets/game-design/zen-world-concept.png"
              alt="gZen Zen World Concept - Low-poly floating diorama sanctuary with pagoda, willow tree, koi pond, and origami carrier crane"
              class="concept-image"
              loading="eager"
            />
          </picture>
          <div class="concept-caption">
            <div class="caption-left">
              <span class="caption-tag">Concept Diorama by Agy</span>
              <span class="caption-desc">Low-Poly Floating Sanctuary · Kyoto/Jiangnan Water Node · Procedural Mist &amp; Carrier Crane</span>
            </div>
            <div class="caption-right">
              <a href="/assets/game-design/zen-world-concept.webp" target="_blank" rel="noopener noreferrer" class="view-raw-link">
                View Full Canvas ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Table of Contents Quicklinks -->
    <nav id="toc" class="toc-card" aria-label="Table of Contents">
      <h2 class="toc-title">Document Directory</h2>
      <div class="toc-grid">
        <a href="#vision" class="toc-item">
          <span class="toc-num">01</span>
          <span class="toc-label">Executive Summary &amp; Vision</span>
        </a>
        <a href="#pillars" class="toc-item">
          <span class="toc-num">02</span>
          <span class="toc-label">Core Gameplay &amp; Slow Transit</span>
        </a>
        <a href="#dharma" class="toc-item">
          <span class="toc-num">03</span>
          <span class="toc-label">Buddhist Wisdom &amp; Seals</span>
        </a>
        <a href="#world" class="toc-item">
          <span class="toc-num">04</span>
          <span class="toc-label">Visual Design &amp; Dioramas</span>
        </a>
        <a href="#tech" class="toc-item">
          <span class="toc-num">05</span>
          <span class="toc-label">Engine Selection &amp; Edge Spec</span>
        </a>
        <a href="#roadmap" class="toc-item">
          <span class="toc-num">06</span>
          <span class="toc-label">Milestones &amp; Roadmap</span>
        </a>
      </div>
    </nav>

    <!-- Main Content Body -->
    <main class="gdd-content">
      <!-- Section 1: Vision -->
      <section id="vision" class="doc-section">
        <div class="section-badge">01. Vision &amp; Philosophy</div>
        <h2>1. Executive Summary &amp; Philosophy</h2>
        
        <div class="callout-box">
          <p class="quote-text">
            "In an attention economy dominated by dopamine loops, algorithmic outrage, and real-time urgency, the gZen Zen Game offers an intentional counter-space: <strong>a world where messages travel slowly across real planetary distances, validation metrics do not exist, and interaction is grounded in the cultivation of the Four Immeasurables (Brahmaviharas).</strong>"
          </p>
        </div>

        <p>
          The <strong>gZen Zen Game</strong> is a tranquil, browser-native sanctuary of gentle human warmth and ancient contemplation. Situated at the intersection of modern mindful play and classical Buddhist philosophy, the experience merges the emotional intimacy of <em>Kind Words (lo fi chill beats to write to)</em>, the deliberateness of <em>Slowly</em>, and the contemplative elegance of <em>Monument Valley</em> and <em>Townscaper</em>.
        </p>

        <div class="immeasurables-grid">
          <div class="immeasurable-card metta">
            <div class="card-kanji">慈</div>
            <div class="card-name">Mettā</div>
            <div class="card-sub">Loving-Kindness</div>
            <p class="card-wish">"May all beings be peaceful."</p>
            <div class="card-manifest">Carrier Cranes &amp; Letters of Peace across planetary arcs.</div>
          </div>
          <div class="immeasurable-card karuna">
            <div class="card-kanji">悲</div>
            <div class="card-name">Karuṇā</div>
            <div class="card-sub">Compassion</div>
            <p class="card-wish">"May all beings be free of pain."</p>
            <div class="card-manifest">Anonymous comfort requests &amp; compassionate listening.</div>
          </div>
          <div class="immeasurable-card mudita">
            <div class="card-kanji">喜</div>
            <div class="card-name">Muditā</div>
            <div class="card-sub">Sympathetic Joy</div>
            <p class="card-wish">"May all beings rejoice in good."</p>
            <div class="card-manifest">Luminous floating river lanterns celebrating small victories.</div>
          </div>
          <div class="immeasurable-card upekkha">
            <div class="card-kanji">捨</div>
            <div class="card-name">Upekkhā</div>
            <div class="card-sub">Equanimity</div>
            <p class="card-wish">"All beings inherit their karma."</p>
            <div class="card-manifest">Quiet stillness, dissolved lanterns, and unattached transit.</div>
          </div>
        </div>

        <div class="pillars-sub-list">
          <div class="sub-pillar-item">
            <h4>🌿 Unrushed Connection</h4>
            <p>True connection requires temporal distance and deliberate reflection rather than instant reply anxiety.</p>
          </div>
          <div class="sub-pillar-item">
            <h4>🕊️ Radical Kindness Without Vanity</h4>
            <p>Zero follower counts, zero public view tallies, zero thumbs-up/down, and zero competitive leaderboards.</p>
          </div>
          <div class="sub-pillar-item">
            <h4>⛩️ Sanctuary of Sound &amp; Form</h4>
            <p>Living dioramas reflecting real-world solar cycles, lunar phases, and gentle weather transitions.</p>
          </div>
        </div>
      </section>

      <!-- Section 2: Core Gameplay Pillars -->
      <section id="pillars" class="doc-section">
        <div class="section-badge">02. Gameplay Mechanics</div>
        <h2>2. Core Gameplay Pillars</h2>

        <div class="gameplay-pillars-grid">
          <div class="pillar-box">
            <div class="pillar-header">
              <span class="pillar-num">Pillar I</span>
              <h3>Slow Asynchronous Letter Transit</h3>
            </div>
            <p>
              Letters travel based on the <strong>Great-Circle Haversine distance</strong> between the sender and recipient sanctuary nodes. Transit duration is bounded between <strong>1 hour minimum</strong> (same city) and <strong>24 hours maximum</strong> (antipodal transit).
            </p>
            <div class="formula-box">
              <code>Δσ = 2 · arcsin( √(sin²(Δϕ/2) + cos(ϕ₁)cos(ϕ₂)sin²(Δλ/2)) )</code>
              <br />
              <code>Transit Time = T_base (1 hr) + [ Distance (km) / 500 km/h ]</code>
            </div>
            <p class="pillar-note">
              Recipients see a graceful origami crane slowly approaching their horizon map, instilling peaceful anticipation.
            </p>
          </div>

          <div class="pillar-box">
            <div class="pillar-header">
              <span class="pillar-num">Pillar II</span>
              <h3>Floating Water Lanterns (Muditā)</h3>
            </div>
            <p>
              Players cast short reflections, wishes, or expressions of sympathetic joy into their sanctuary's stream. Lanterns drift along procedural currents past worldwide visitors before dissolving into mist over 24–48 hours (*Anicca* / Impermanence).
            </p>
          </div>

          <div class="pillar-box">
            <div class="pillar-header">
              <span class="pillar-num">Pillar III</span>
              <h3>Carrier Cranes &amp; Comfort Requests</h3>
            </div>
            <p>
              A player in distress may fold a <em>Silent Origami Crane</em> with an anonymous vulnerability. The engine gently pairs it with opt-in mindful wanderers worldwide for empathetic handwritten replies.
            </p>
          </div>

          <div class="pillar-box">
            <div class="pillar-header">
              <span class="pillar-num">Pillar IV</span>
              <h3>Gratitude-Only Feedback (Gasshō Bow)</h3>
            </div>
            <p>
              No threaded argument loops or flame wars. Senders can only be thanked with a single **Gasshō (合十)** bow or a handcrafted **Gratitude Stamp (印章)**. Letters then tuck into the private Tea Chest.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Buddhist Wisdom & Stamps -->
      <section id="dharma" class="doc-section">
        <div class="section-badge">03. Dharma Seeds &amp; Seals</div>
        <h2>3. Buddhist Wisdom &amp; Dharma Seeds</h2>

        <div class="dharma-flow-card">
          <div class="flow-step">
            <span class="step-badge">Dawn</span>
            <h4>Daily Dharma Seed</h4>
            <p>Trilingual verse (EN / ZH / JA) blooming at local sunrise with 30-second silent breathing chime.</p>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="step-badge">Practice</span>
            <h4>Seal of Right Action</h4>
            <p>Unlock traditional stone chop seals by practicing consistent kindness and thoughtful reflection.</p>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <span class="step-badge">Archive</span>
            <h4>Handmade Paper Scroll</h4>
            <p>Preserve heartfelt correspondences in a private, encrypted offline tea chest.</p>
          </div>
        </div>

        <div class="seals-overview">
          <h3>Collectible Zen Seals &amp; Stamps (印章 / 篆刻)</h3>
          <p>
            Players position and stamp cinnabar (硃砂) and saffron seals onto letter canvas with realistic ink pressure and fiber-bleed shaders.
          </p>
          <div class="seals-tags">
            <span class="seal-pill">🌸 Plum Blossom (Early Spring)</span>
            <span class="seal-pill">🎋 Bamboo Grove (Summer Rain)</span>
            <span class="seal-pill">🍂 Autumn Ginkgo</span>
            <span class="seal-pill">❄️ Pine Needle in Snow</span>
            <span class="seal-pill">💧 Still River (止水)</span>
            <span class="seal-pill">🕯️ Beginner's Mind (初心)</span>
            <span class="seal-pill">🌟 Pure Radiance (明照)</span>
            <span class="seal-pill">🪷 Great Compassion (大悲)</span>
          </div>
        </div>
      </section>

      <!-- Section 4: World & Visual Design -->
      <section id="world" class="doc-section">
        <div class="section-badge">04. Visual, World Map &amp; Biomes</div>
        <h2>4. Global World Map, Biomes &amp; Progressive Unlocking</h2>
        
        <p>
          The world of gZen is designed as a simplified, stylized 3D low-poly globe divided hierarchically into <strong>Continents &rarr; Regional Sanctuaries &rarr; Country Nodes</strong>. The experience is framed in hand-painted water-ink (<em>Shanshui / Sumi-e</em>) wash shaders, soft ambient occlusion, and meditative depth-of-field tilt-shift.
        </p>

        <!-- World Map & Fog of Kindness Mechanics -->
        <div class="mechanics-highlight-box">
          <div class="highlight-badge">Core Macro System</div>
          <h3>Progressive "Fog-of-Kindness" (善意之雾) &amp; Flight Path Visual Arcs</h3>
          <div class="highlight-columns">
            <div class="highlight-col">
              <h4>🕊️ Origin Sanctuary Genesis</h4>
              <p>
                Every player begins within their local regional sanctuary (e.g. Kyoto Zen Garden, Jiangnan Water Canal, or Emerald Bamboo Grove). Distant continents and countries are softly veiled under an ethereal morning mist.
              </p>
            </div>
            <div class="highlight-col">
              <h4>✨ Mist-Clearing Resonance</h4>
              <p>
                As players write compassionate letters, send micro-blessings, and exchange correspondence across borders, distant regions clear their clouds, unlocking new regional 3D dioramas, traditional OST instruments, and native fauna.
              </p>
            </div>
            <div class="highlight-col">
              <h4>🌐 Real-Time Transit Arcs</h4>
              <p>
                Glowing spherical geodesic arcs trace real-time origami crane journeys between distant senders and receivers, leaving soft golden phosphor trails across the low-poly globe.
              </p>
            </div>
          </div>
        </div>

        <!-- Visual Showcase Gallery: 10 Imagined Scenes -->
        <div class="gallery-header">
          <h3>Visual Showcase: 10 Imagined Scenes &amp; Gameplay Moments</h3>
          <p class="gallery-subtitle">
            A curated gallery exploring macro world navigation, regional biomes, mindful writing tools, and collective meditative rituals.
          </p>
        </div>

        <div class="gallery-grid">
          <!-- Scene 1 -->
          <div class="gallery-card">
            <div class="gallery-media">
              <picture>
                <source srcset="/assets/game-design/world-map-continents.webp" type="image/webp" />
                <img src="/assets/game-design/world-map-continents.png" alt="Global World Globe & Continent Progression - 3D stylized globe with glowing transit arcs and mist-shrouded continents" loading="lazy" />
              </picture>
              <div class="media-badges">
                <span class="media-badge macro">World Map</span>
                <span class="media-badge progression">Progression</span>
              </div>
            </div>
            <div class="gallery-info">
              <div class="scene-num">01 / 10</div>
              <h4>Global World Globe &amp; Continent Progression</h4>
              <p class="scene-desc">
                A stylized low-poly 3D globe suspended in tranquil midnight-slate space. Luminous geodesic flight arcs trace origami carrier cranes across oceans. Distant lands are softly shrouded in ethereal morning mist awaiting discovery through cross-border kindness.
              </p>
              <div class="scene-meta">
                <span><strong>System:</strong> Macro Navigation</span>
                <span><strong>Visual:</strong> Geodesic Arcs &amp; Mist Shaders</span>
              </div>
            </div>
          </div>

          <!-- Scene 2 -->
          <div class="gallery-card">
            <div class="gallery-media">
              <picture>
                <source srcset="/assets/game-design/biome-east-asia-jiangnan.webp" type="image/webp" />
                <img src="/assets/game-design/biome-east-asia-jiangnan.png" alt="East Asia Jiangnan Water Canal Sanctuary - Whitewashed pavilion, weeping willows, and floating lotuses" loading="lazy" />
              </picture>
              <div class="media-badges">
                <span class="media-badge biome">East Asia</span>
                <span class="media-badge gameplay">Aquatic Sanctuary</span>
              </div>
            </div>
            <div class="gallery-info">
              <div class="scene-num">02 / 10</div>
              <h4>East Asia: Jiangnan Water Canal Sanctuary</h4>
              <p class="scene-desc">
                Whitewashed Jiangnan pavilions with dark curved eaves, weeping willows gently swaying over emerald water canals, stone arched bridges, and floating pink lotus blossoms catching warm morning rays.
              </p>
              <div class="scene-meta">
                <span><strong>Biome:</strong> Jiangnan Water Canal</span>
                <span><strong>Ritual:</strong> Floating Lantern Release</span>
              </div>
            </div>
          </div>

          <!-- Scene 3 -->
          <div class="gallery-card">
            <div class="gallery-media">
              <picture>
                <source srcset="/assets/game-design/biome-south-asia-himalayas.webp" type="image/webp" />
                <img src="/assets/game-design/biome-south-asia-himalayas.png" alt="South Asia Himalayan Mountain Stupa of Equanimity - High-altitude stone stupa with colorful prayer flags" loading="lazy" />
              </picture>
              <div class="media-badges">
                <span class="media-badge biome">South Asia</span>
                <span class="media-badge gameplay">Equanimity Node</span>
              </div>
            </div>
            <div class="gallery-info">
              <div class="scene-num">03 / 10</div>
              <h4>South Asia: Himalayan Stupa of Equanimity</h4>
              <p class="scene-desc">
                A serene high-altitude stone Stupa perched atop snow-dusted mountain ridges, surrounded by vibrant Buddhist prayer flags fluttering in alpine breezes under clear azure skies.
              </p>
              <div class="scene-meta">
                <span><strong>Biome:</strong> Alpine Peak &amp; Stupa</span>
                <span><strong>Dharma:</strong> Upekkhā (Equanimity &amp; Letting Go)</span>
              </div>
            </div>
