---
import BaseLayout from "../layouts/BaseLayout.astro";
import Starfield from "../components/Starfield.astro";
import GeometricField from "../components/GeometricField.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Hero from "../components/Hero.astro";
import PathGrid from "../components/PathGrid.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout>
  <Starfield />
  <GeometricField />
  <ThemeToggle />

  <main class="wrap">
    <Hero />
    <PathGrid />
    <SiteFooter />
  </main>

  <div class="cursor-glow" aria-hidden="true"></div>
</BaseLayout>

<style>
  .wrap {
    position: relative;
    z-index: 1;
    max-width: var(--max);
    width: 100%;
    margin: 0 auto;
    padding: 0 clamp(1.35rem, 4.5vw, 2rem) clamp(2.5rem, 6vw, 3.5rem);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
  }

  .cursor-glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(
      560px circle at var(--px, 50%) var(--py, 18%),
      var(--cursor-glow),
      transparent 55%
    );
    opacity: 0.95;
    transition: opacity 0.45s var(--ease);
  }

  @media (prefers-reduced-motion: reduce), (pointer: coarse) {
    .cursor-glow {
      display: none;
    }
  }

  :global(.path-key-flash) {
    border-color: color-mix(
      in srgb,
      var(--path-tone, var(--accent)) 45%,
      var(--line-strong)
    ) !important;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 0 36px color-mix(in srgb, var(--path-tone, var(--accent)) 22%, transparent) !important;
  }
</style>
