---
/**
 * LOCAL / DEV ONLY — brand asset review gallery.
 * Stripped from production builds (see package.json "build").
 * Open via StackySentinel: proposal.sh  →  :1318/proposal
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { markProposals, site } from "../data/paths";

import enso from "../assets/proposals/01-enso-g.svg?raw";
import orbit from "../assets/proposals/02-orbit-g.svg?raw";
import ignite from "../assets/proposals/03-ignite-g.svg?raw";
import voidG from "../assets/proposals/04-void-g.svg?raw";

const svgs: Record<string, string> = {
  "enso-g": enso,
  "orbit-g": orbit,
  "ignite-g": ignite,
  "void-g": voidG,
};

const isProdBuild = import.meta.env.PROD;
---

{
  isProdBuild ? (
    <BaseLayout title="Not found · gZen" description="This page is not available.">
      <main class="gone">
        <p class="eyebrow">gZen</p>
        <h1>Nothing here.</h1>
        <p>Asset proposals are local-only and never ship to production.</p>
        <a href="/">Back to gZen</a>
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="gZen · Asset proposals (local)"
      description="Local-only brand mark and favicon proposals for review."
    >
      <main class="wrap">
        <header class="head">
          <p class="badge">Local only · never in production</p>
          <h1>Asset proposals</h1>
          <p class="lede">
            Review candidate marks for favicon and optional monogram.
            <strong>Shipped:</strong> <code>enso-g</code> (favicon). Reply with another id to switch.
          </p>
          <nav class="links">
            <a href="/">← Portal</a>
            <span class="sep">·</span>
            <a href="#marks">Marks</a>
            <span class="sep">·</span>
            <a href="#wordmark">Wordmark</a>
            <span class="sep">·</span>
            <a href="#favicon-sizes">Favicon sizes</a>
          </nav>
        </header>

        <section id="marks" class="section">
          <h2>Mark candidates</h2>
          <p class="hint">Current live favicon is text “gZ” + amber dot. These replace it.</p>
          <div class="grid">
            {markProposals.map((m) => (
              <article class="card" id={m.id}>
                <div class="preview" set:html={svgs[m.id]} />
                <div class="meta">
                  <div class="row">
                    <h3>{m.name}</h3>
                    <code class="id">{m.id}</code>
                  </div>
                  <p>{m.pitch}</p>
                  <p class="file">{m.file}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="wordmark" class="section">
          <h2>Hero wordmark (text)</h2>
          <p class="hint">Recommended: text-only in hero. Small monogram optional above.</p>
          <div class="word-demo">
            <div class="wm-block">
              <p class="label">Text only</p>
              <p class="wm">
                <span class="g">g</span>
                <span class="zen">Zen</span>
              </p>
            </div>
            <div class="wm-block">
              <p class="label">Mark + text (sample · enso-g)</p>
              <div class="wm-with-mark">
                <div class="tiny-mark" set:html={enso} />
                <p class="wm">
                  <span class="g">g</span>
                  <span class="zen">Zen</span>
                </p>
              </div>
            </div>
          </div>
          <p class="hook-demo">{site.hook}</p>
        </section>

        <section id="favicon-sizes" class="section">
          <h2>Favicon size check</h2>
          <p class="hint">Does it hold at 16 / 32 / 64?</p>
          <div class="sizes">
            {markProposals.map((m) => (
              <div class="size-col">
                <p class="label">{m.id}</p>
                <div class="size-row">
                  {[16, 32, 64].map((px) => (
                    <div class="size-cell">
                      <div
                        class="size-frame"
                        style={`width:${px}px;height:${px}px`}
                        set:html={svgs[m.id]}
                      />
                      <span>{px}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <footer class="foot">
          <p>
            StackySentinel: run <code>proposal.sh</code> to push this link on Telegram.
          </p>
          <p class="muted">
            URL: <code>/proposal</code> · port 1318 · stripped on <code>npm run build</code>
          </p>
        </footer>
      </main>
    </BaseLayout>
  )
}

<style>
  .gone {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  .gone h1 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .gone p {
    margin: 0;
    color: var(--muted);
  }

  .gone a {
    margin-top: 0.5rem;
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
    text-decoration: none;
  }

  .wrap {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 4vw, 1.75rem) 3rem;
  }

  .head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .badge {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 550;
    letter-spacing: -0.035em;
  }

  .lede {
    margin: 0.85rem 0 0;
    max-width: 36rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .lede code,
  .foot code,
  .id,
  .file {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
    font-size: 0.9rem;
    color: var(--dim);
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .links a:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .sep {
    opacity: 0.4;
  }

  .section {
    margin-top: 2.75rem;
  }

  .section h2 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .hint {
    margin: 0 0 1.25rem;
    color: var(--dim);
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }

  .preview {
    display: grid;
    place-items: center;
    padding: 1.75rem;
    background: #050505;
    border-bottom: 1px solid var(--line);
  }

  .preview :global(svg) {
    width: 96px;
    height: 96px;
    display: block;
  }

  .meta {
    padding: 1rem 1.15rem 1.2rem;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }

  .meta h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 550;
  }

  .id {
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .meta p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .file {
    margin-top: 0.55rem !important;
    color: var(--dim) !important;
    font-size: 0.72rem !important;
  }

  .word-demo {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .word-demo {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wm-block {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .wm {
    margin: 0;
    font-size: 2.75rem;
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .wm .g {
    opacity: 0.88;
    font-weight: 400;
  }

  .wm .zen {
    font-weight: 560;
  }

  .wm-with-mark {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .tiny-mark {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
  }

  .tiny-mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hook-demo {
    margin: 1.25rem 0 0;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .sizes {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .size-col {
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--card);
  }

  .size-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-end;
  }

  .size-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .size-cell span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--dim);
  }

  .size-frame {
    background: #050505;
    border-radius: 2px;
    overflow: hidden;
    image-rendering: auto;
  }

  .size-frame :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--muted);
  }

  .foot p {
    margin: 0 0 0.4rem;
  }

  .muted {
    color: var(--dim) !important;
  }
</style>
