---
import BaseLayout from "../layouts/BaseLayout.astro";
import UnifiedNav from "../components/UnifiedNav.astro";
import gameGenes from "../data/game-genes.json";

const meta = {
  title: "Zen 3D Sanctuary — Living Contemplative Diorama | gZen",
  description: "A contemplative 3D Zen sanctuary diorama featuring slow transit mechanics, singing bell meditation, active koi swimming, and Kyoto garden aesthetics.",
};
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="sanctuary-container">
    <UnifiedNav activeTab="game" />

    <main class="viewport-wrapper">
      <div id="three-canvas-container" class="canvas-container">
        <div id="loading-overlay" class="loading-overlay">
          <div class="spinner"></div>
          <p class="loading-text">Awakening Zen Sanctuary...</p>
        </div>
      </div>

      <!-- Interactive Hover Target Reticle / Tooltip -->
      <div id="target-tooltip" class="target-tooltip" aria-hidden="true">
        <span class="tooltip-glyph">✦</span>
        <span id="tooltip-label" class="tooltip-label">Singing Bell</span>
      </div>

      <!-- Top Right: Contemplation Feedback & Camera Presets -->
      <header class="top-controls-container">
        <div class="preset-pill-group" role="group" aria-label="Camera Presets">
          <button class="preset-btn active" data-view="orbit" title="Classic Isometric Orbit (1)">
            <span class="btn-icon">🏯</span>
            <span class="btn-text">Diorama</span>
          </button>
          <button class="preset-btn" data-view="bell" title="Bell Shrine Focus (2)">
            <span class="btn-icon">🔔</span>
            <span class="btn-text">Shrine</span>
          </button>
          <button class="preset-btn" data-view="pond" title="Reflecting Koi Garden (3)">
            <span class="btn-icon">🪷</span>
            <span class="btn-text">Pond</span>
          </button>
          <button id="breathe-toggle" class="preset-btn breathe-btn" title="Toggle 6s Pranayama Breath Rhythm (Space)">
            <span class="btn-icon">🧘</span>
            <span class="btn-text">Breathe</span>
          </button>
        </div>

        <!-- Genetic Player Feedback Pill -->
        <div class="feedback-card" aria-label="Contemplation Evaluation">
          <span class="feedback-title">Contemplation:</span>
          <div class="feedback-buttons">
            <button class="fb-btn fb-empty" data-rating="empty" title="Deepen mist and floating motes">🪨 Empty</button>
            <button class="fb-btn fb-grounded active" data-rating="grounded" title="Harmonious golden balance">🪷 Grounded</button>
            <button class="fb-btn fb-noisy" data-rating="noisy" title="Calm turbulence & slow motion">🌪️ Noisy</button>
          </div>
        </div>
      </header>

      <!-- Pranayama Breathing Guide Ring Overlay -->
      <div id="breath-guide-overlay" class="breath-guide-overlay hidden" aria-hidden="true">
        <div class="breath-ring">
          <div class="breath-pulse"></div>
          <span id="breath-status-text" class="breath-status-text">Inhale (3s)</span>
        </div>
      </div>

      <!-- Bottom Left: Interactive Sanctuary HUD Card -->
      <aside class="hud-overlay">
        <div class="hud-card">
          <div class="hud-header-strip">
            <span class="brand-kicker">✦ gZen Living Diorama</span>
            <span id="interaction-badge" class="interaction-badge">✨ Ready</span>
          </div>
          <h1 class="hud-title">Living Sanctuary v0.3</h1>
          <p id="hud-quote" class="hud-desc">
            "When the singing bowl is struck, sound dissolves into silence. In silence, the true mind awakens."
          </p>

          <div class="hud-action-row">
            <button id="chime-btn" class="hud-action-btn primary" title="Strike Bell (B)">
              <span>🔔 Strike Bell</span>
            </button>
            <button id="lantern-btn" class="hud-action-btn" title="Toggle Sacred Flame (L)">
              <span>🏮 Kindle Lantern</span>
            </button>
            <button id="crane-btn" class="hud-action-btn special" title="Release Slow Transit Origami Crane (C)">
              <span>🕊️ Send Crane</span>
            </button>
          </div>

          <div class="hud-controls-hint">
            <span class="hint-tag"><kbd>Drag</kbd> Orbit</span>
            <span class="hint-tag"><kbd>Click</kbd> Bell / Pond / Koi</span>
            <span class="hint-tag"><kbd>B</kbd> Bell</span>
            <span class="hint-tag"><kbd>L</kbd> Lantern</span>
            <span class="hint-tag"><kbd>C</kbd> Crane</span>
            <span class="hint-tag"><kbd>Space</kbd> Breathe</span>
          </div>
        </div>
      </aside>

      <!-- Toast Notification for Dynamic Feedback -->
      <div id="zen-toast" class="zen-toast" role="status" aria-live="polite"></div>
    </main>
  </div>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

  const container = document.getElementById('three-canvas-container');
  const loadingOverlay = document.getElementById('loading-overlay');
  const targetTooltip = document.getElementById('target-tooltip');
  const tooltipLabel = document.getElementById('tooltip-label');
  const interactionBadge = document.getElementById('interaction-badge');
  const hudQuote = document.getElementById('hud-quote');
  const zenToast = document.getElementById('zen-toast');
  const breathOverlay = document.getElementById('breath-guide-overlay');
  const breathText = document.getElementById('breath-status-text');

  // Zen Koan & Wisdom Seals
  const ZEN_INSIGHTS = [
    "When the singing bowl is struck, sound dissolves into silence. In silence, the true mind awakens.",
    "The river flows without hurrying to reach the ocean. Be the water, not the stone.",
    "Loving-kindness (Mettā) is the open heart that holds all beings without condition.",
    "Equanimity (Upekkhā) is the mountain that remains unshakeable in the fierce wind.",
    "The crane carries a folded letter across distance, arriving exactly when ready.",
    "A single spark in the stone lantern gently illuminates the darkest mountain path.",
    "In the still surface of the pond, the moon reflects without effort."
  ];

  if (container) {
    const width = container.clientWidth;
    const height = container.clientHeight;

    // --- 1. Sound Synthesis Engine (Web Audio API) ---
    let audioCtx: AudioContext | null = null;
    const ensureAudio = () => {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    };

    // Harmonic Tibetan Singing Bowl Chime (432Hz + Overtones)
    const playZenBell = () => {
      try {
        const ctx = ensureAudio();
        const now = ctx.currentTime;

        // Fundamental 432Hz
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(432, now);
        osc1.frequency.exponentialRampToValueAtTime(430.5, now + 5.5);
        gain1.gain.setValueAtTime(0.38, now);
        gain1.gain.exponentialRampToValueAtTime(0.0001, now + 5.5);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);

        // 1st Overtone (864Hz octave)
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(864, now);
        osc2.frequency.exponentialRampToValueAtTime(861, now + 4.2);
        gain2.gain.setValueAtTime(0.18, now);
        gain2.gain.exponentialRampToValueAtTime(0.0001, now + 4.2);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);

        // 2nd Harmonic (1296Hz upper shimmer)
        const osc3 = ctx.createOscillator();
        const gain3 = ctx.createGain();
        osc3.type = 'sine';
        osc3.frequency.setValueAtTime(1296, now);
        osc3.frequency.exponentialRampToValueAtTime(1290, now + 2.8);
        gain3.gain.setValueAtTime(0.09, now);
        gain3.gain.exponentialRampToValueAtTime(0.0001, now + 2.8);
        osc3.connect(gain3);
        gain3.connect(ctx.destination);

        osc1.start(now);
        osc2.start(now);
        osc3.start(now);
        osc1.stop(now + 5.6);
        osc2.stop(now + 4.3);
        osc3.stop(now + 2.9);
      } catch (e) {
        console.warn('Audio chime error:', e);
      }
    };

    // Soothing Water Droplet Tone
    const playWaterRippleAudio = () => {
      try {
        const ctx = ensureAudio();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(840, now);
        osc.frequency.exponentialRampToValueAtTime(380, now + 0.35);
        gain.gain.setValueAtTime(0.18, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.4);
      } catch (e) {
        console.warn('Water audio error:', e);
      }
    };

    // Soft Lantern Ignition Tone
    const playLanternIgniteAudio = () => {
      try {
        const ctx = ensureAudio();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(260, now);
        osc.frequency.exponentialRampToValueAtTime(520, now + 0.6);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.7);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.72);
      } catch (e) {
        console.warn('Lantern audio error:', e);
      }
    };

    // --- 2. Three.js Scene, Camera, Lighting & Renderer ---
    const scene = new THREE.Scene();
    const warmCreamBg = 0xfbf9f5;
    scene.background = new THREE.Color(warmCreamBg);
    scene.fog = new THREE.FogExp2(warmCreamBg, 0.028);

    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.set(9, 6.5, 11);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: 'high-performance' });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.04;
    controls.maxPolarAngle = Math.PI / 2.05;
    controls.minDistance = 3.5;
    controls.maxDistance = 24;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.35;

    // Ambient Lighting — Warm monastic morning wash
    const ambientLight = new THREE.AmbientLight(0xfff5ea, 1.35);
    scene.add(ambientLight);

    // Directional Sunlight with Soft Shadows
    const sunLight = new THREE.DirectionalLight(0xfffaec, 2.0);
    sunLight.position.set(12, 16, 8);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 1024;
    sunLight.shadow.mapSize.height = 1024;
    sunLight.shadow.bias = -0.0003;
    scene.add(sunLight);

    // Warm Golden Fill Light
    const fillLight = new THREE.DirectionalLight(0xfef3c7, 0.85);
    fillLight.position.set(-10, 8, -6);
    scene.add(fillLight);

    // Sky Edge Rim Light
    const rimLight = new THREE.DirectionalLight(0xe0e7ff, 0.4);
    rimLight.position.set(0, -6, 10);
    scene.add(rimLight);

    // --- 3. Karesansui Raked Zen Sand Rings (Floor Aesthetic) ---
    const sandFloorGroup = new THREE.Group();
    sandFloorGroup.position.y = -2.3;
    scene.add(sandFloorGroup);

    // Concentric rippling sand rings
    const sandColors = [0xf5ece1, 0xeee3d5, 0xe7dac9, 0xe0d0be];
    for (let r = 1.5; r <= 14; r += 1.2) {
      const ringGeo = new THREE.RingGeometry(r - 0.08, r, 64);
      const ringMat = new THREE.MeshBasicMaterial({
        color: sandColors[Math.floor(r) % sandColors.length],
        side: THREE.DoubleSide,
        transparent: true,
        opacity: Math.max(0.12, 0.5 - (r / 18)),
      });
      const ringMesh = new THREE.Mesh(ringGeo, ringMat);
      ringMesh.rotation.x = -Math.PI / 2;
      sandFloorGroup.add(ringMesh);
    }

    // --- 4. Floating Island Group & Diorama Mesh Hooks ---
    const islandGroup = new THREE.Group();
    scene.add(islandGroup);

    // Object References for Raycasting & Kinetic Animation
    let bellMesh: THREE.Mesh | null = null;
    let pondMesh: THREE.Mesh | null = null;
    let lanternMesh: THREE.Mesh | null = null;
    const koiMeshes: THREE.Mesh[] = [];
    const cloudMeshes: THREE.Mesh[] = [];
    const interactiveTargets: THREE.Object3D[] = [];

    // Lantern Sacred PointLight
    const lanternLight = new THREE.PointLight(0xd97845, 0, 8, 1.8);
    lanternLight.castShadow = true;
    islandGroup.add(lanternLight);
    let lanternLit = false;

    // Bell Dynamic Swing Physics
    let bellSwingAngle = 0;
    let bellSwingVelocity = 0;

    // Load V3 Living Diorama Model
    const loader = new GLTFLoader();
    loader.load(
      '/models/zen_diorama_v3.glb',
      (gltf) => {
        const model = gltf.scene;
        model.traverse((child) => {
          if ((child as THREE.Mesh).isMesh) {
            const mesh = child as THREE.Mesh;
            mesh.castShadow = true;
            mesh.receiveShadow = true;

            if (mesh.name.includes('Pond')) {
              // Deep Serene Jade-Teal Water (Brand Jade #2d6b4f harmony)
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x204840,
                roughness: 0.04,
                metalness: 0.35,
                transparent: true,
                opacity: 0.88,
              });
              pondMesh = mesh;
              interactiveTargets.push(mesh);
            } else if (mesh.name.includes('Koi')) {
              // Vermilion Orange Kohaku Koi
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0xe05a2b,
                roughness: 0.25,
                metalness: 0.15,
              });
              koiMeshes.push(mesh);
              interactiveTargets.push(mesh);
            } else if (mesh.name.includes('PineFoliage')) {
              // Warm Jade Evergreen (#2d6b4f)
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x2d6b4f,
                roughness: 0.78,
                metalness: 0.05,
              });
            } else if (mesh.name.includes('PineTrunk')) {
              // Aged Pine Cedar Bark
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x453125,
                roughness: 0.88,
              });
            } else if (mesh.name.includes('Roof')) {
              // Saffron Amber Eave Tile (#b45309)
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0xb45309,
                roughness: 0.42,
              });
            } else if (mesh.name.includes('Pillar') || mesh.name.includes('Platform')) {
              // Earthy Dark Cedar Timber (#2f2118)
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x271e18,
                roughness: 0.68,
              });
            } else if (mesh.name.includes('Bell')) {
              // Polished Monastic Bronze (#d97845)
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0xd97845,
                metalness: 0.9,
                roughness: 0.22,
              });
              bellMesh = mesh;
              interactiveTargets.push(mesh);
            } else if (mesh.name.includes('Lantern')) {
              // Garden Granite Lantern with Inner Glow
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x9c948a,
                roughness: 0.82,
              });
              lanternMesh = mesh;
              interactiveTargets.push(mesh);
              // Position lantern light at lantern
              const lanternBox = new THREE.Box3().setFromObject(mesh);
              const lanternCenter = lanternBox.getCenter(new THREE.Vector3());
              lanternLight.position.copy(lanternCenter);
              lanternLight.position.y += 0.2;
            } else if (mesh.name.includes('Underbelly')) {
              // Stratified Volcanic Bedrock / Dark Earth Loam
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x352820,
                roughness: 0.95,
              });
            } else if (mesh.name.includes('FacetedRock')) {
              // Weathered Mossy Terrace Stone
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x787268,
                roughness: 0.85,
              });
            } else if (mesh.name.includes('RiverRock')) {
              // Polished Graphite River Pebbles
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x48433d,
                roughness: 0.35,
              });
            } else if (mesh.name.includes('Cloud')) {
              // Translucent Mist Puffs
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0xfffaf2,
                roughness: 0.9,
                transparent: true,
                opacity: 0.78,
              });
              cloudMeshes.push(mesh);
            } else {
              mesh.material = new THREE.MeshStandardMaterial({
                color: 0x8a8278,
                roughness: 0.85,
              });
            }
          }
        });

        islandGroup.add(model);

        if (loadingOverlay) {
          loadingOverlay.style.opacity = '0';
          setTimeout(() => loadingOverlay.remove(), 400);
        }
      },
      undefined,
      (error) => {
        console.error('Failed to load V3 diorama model:', error);
      }
    );

    // --- 5. Atmospheric Golden Motes (Pollen & Incense) ---
    const moteCount = 45;
    const moteGeo = new THREE.BufferGeometry();
    const motePositions = new Float32Array(moteCount * 3);
    const moteSpeeds: number[] = [];

    for (let i = 0; i < moteCount; i++) {
      motePositions[i * 3] = (Math.random() - 0.5) * 12;
      motePositions[i * 3 + 1] = Math.random() * 8;
      motePositions[i * 3 + 2] = (Math.random() - 0.5) * 12;
      moteSpeeds.push(0.005 + Math.random() * 0.012);
    }

    moteGeo.setAttribute('position', new THREE.BufferAttribute(motePositions, 3));
    const moteMat = new THREE.PointsMaterial({
      color: 0xd97845,
      size: 0.14,
      transparent: true,
      opacity: 0.65,
      blending: THREE.AdditiveBlending,
    });
    const motePoints = new THREE.Points(moteGeo, moteMat);
    scene.add(motePoints);

    // --- 6. Visual Golden Soundwave Shockwave (Bell Chime) ---
    const soundRingGeo = new THREE.TorusGeometry(0.3, 0.04, 16, 64);
    const soundRingMat = new THREE.MeshBasicMaterial({
      color: 0xd97845,
      transparent: true,
      opacity: 0,
      side: THREE.DoubleSide,
    });
    const soundRing = new THREE.Mesh(soundRingGeo, soundRingMat);
    soundRing.rotation.x = Math.PI / 2;
    scene.add(soundRing);
    let soundRingActive = false;
    let soundRingScale = 1;
    let soundRingOpacity = 0;

    const triggerSoundRing = (pos: THREE.Vector3) => {
      soundRing.position.copy(pos);
      soundRingScale = 0.5;
      soundRingOpacity = 0.9;
      soundRingActive = true;
    };

    // --- 7. Water Ripple Rings System ---
    interface WaterRipple {
      mesh: THREE.Mesh;
      scale: number;
      opacity: number;
    }
    const ripples: WaterRipple[] = [];
    const rippleGeo = new THREE.RingGeometry(0.05, 0.1, 32);

    const spawnWaterRipple = (pos: THREE.Vector3) => {
      const mat = new THREE.MeshBasicMaterial({
        color: 0x6ee7b7,
        transparent: true,
        opacity: 0.8,
        side: THREE.DoubleSide,
      });
      const mesh = new THREE.Mesh(rippleGeo, mat);
      mesh.position.copy(pos);
      mesh.position.y += 0.02;
      mesh.rotation.x = -Math.PI / 2;
      islandGroup.add(mesh);
      ripples.push({ mesh, scale: 0.2, opacity: 0.85 });
    };

    // --- 8. Slow Transit: Origami Crane Flight ---
    interface OrigamiCrane {
      group: THREE.Group;
      progress: number;
      start: THREE.Vector3;
      end: THREE.Vector3;
      speed: number;
    }
    const cranes: OrigamiCrane[] = [];

    const spawnOrigamiCrane = () => {
      const craneGroup = new THREE.Group();

      // Low-poly Origami Crane Geometry
      const bodyMat = new THREE.MeshStandardMaterial({
        color: 0xfffaf4,
        roughness: 0.6,
        side: THREE.DoubleSide,
      });
      const accentMat = new THREE.MeshStandardMaterial({
        color: 0xb45309,
        roughness: 0.5,
      });

      // Simple origami bird triangles
      const wingGeo = new THREE.BufferGeometry();
      const wingVertices = new Float32Array([
        0, 0, 0,
        1.0, 0.2, 0.4,
        0.3, 0, -0.6,
        0, 0, 0,
        -1.0, 0.2, 0.4,
        -0.3, 0, -0.6,
      ]);
      wingGeo.setAttribute('position', new THREE.BufferAttribute(wingVertices, 3));
      wingGeo.computeVertexNormals();

      const wings = new THREE.Mesh(wingGeo, bodyMat);
      craneGroup.add(wings);

      // Crane beak / letter seal
      const beakGeo = new THREE.ConeGeometry(0.08, 0.35, 4);
      const beak = new THREE.Mesh(beakGeo, accentMat);
      beak.rotation.x = Math.PI / 2;
      beak.position.z = 0.45;
      craneGroup.add(beak);

      craneGroup.scale.set(0.45, 0.45, 0.45);

      const start = new THREE.Vector3(
        (Math.random() - 0.5) * 2,
        2.5,
        (Math.random() - 0.5) * 2
      );
      const end = new THREE.Vector3(
        (Math.random() - 0.5) * 14 + 10,
        9 + Math.random() * 4,
        (Math.random() - 0.5) * 14 - 10
      );

      craneGroup.position.copy(start);
      craneGroup.lookAt(end);
      scene.add(craneGroup);

      cranes.push({
        group: craneGroup,
        progress: 0,
        start,
        end,
        speed: 0.0035,
      });

      showToast("🕊️ Origami Crane released into the mountain mist with your contemplation.");
    };

    // --- 9. Toast Notification Helper ---
    const showToast = (message: string) => {
      if (!zenToast) return;
      zenToast.textContent = message;
      zenToast.classList.add('visible');
      setTimeout(() => {
        zenToast.classList.remove('visible');
      }, 3400);
    };

    // --- 10. Raycasting & Hover Feedback ---
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2(-999, -999);
    let hoveredObject: THREE.Object3D | null = null;

    const onPointerMove = (e: MouseEvent) => {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

      // Position floating tooltip
      if (targetTooltip && hoveredObject) {
        targetTooltip.style.left = `${e.clientX + 14}px`;
        targetTooltip.style.top = `${e.clientY - 28}px`;
      }
    };

    window.addEventListener('pointermove', onPointerMove);

    // --- 11. Interactive Click Dispatcher ---
    const strikeBell = () => {
      playZenBell();
      bellSwingVelocity = 0.18;

      if (bellMesh) {
        const bellWorldPos = new THREE.Vector3();
        bellMesh.getWorldPosition(bellWorldPos);
        triggerSoundRing(bellWorldPos);
      }

      // Rotate wisdom quote
      const quote = ZEN_INSIGHTS[Math.floor(Math.random() * ZEN_INSIGHTS.length)];
      if (hudQuote) hudQuote.textContent = `"${quote}"`;
      if (interactionBadge) interactionBadge.textContent = '🔔 Chime Resonating';

      showToast("🔔 432Hz Singing Bowl resonated. Sound dissolves into stillness.");
      setTimeout(() => {
        if (interactionBadge) interactionBadge.textContent = '✨ Stillness';
      }, 4000);
    };

    const toggleLantern = () => {
      lanternLit = !lanternLit;
      playLanternIgniteAudio();

      if (lanternLit) {
        lanternLight.intensity = 1.9;
        showToast("🏮 Sacred lantern flame kindled. Warmth rests upon cedar.");
        if (interactionBadge) interactionBadge.textContent = '🏮 Sacred Flame';
      } else {
        lanternLight.intensity = 0;
        showToast("🏮 Sacred lantern softened to quiet ember.");
        if (interactionBadge) interactionBadge.textContent = '✨ Quietude';
      }
    };

    const triggerPondRipple = (hitPoint: THREE.Vector3) => {
      playWaterRippleAudio();
      // Convert world hit point to island group local
      const localPoint = islandGroup.worldToLocal(hitPoint.clone());
      spawnWaterRipple(localPoint);
      showToast("🪷 Droplet touches the sacred pond. Thoughts ripple and settle.");
    };

    const triggerKoiInteraction = (koi: THREE.Mesh) => {
      playWaterRippleAudio();
      // Brief joyful leap
      koi.position.y += 0.35;
      setTimeout(() => {
        koi.position.y -= 0.35;
      }, 350);
      showToast("🐟 The Kohaku Koi twirls gently, welcoming your attention.");
    };

    // Canvas Pointer Down Raycast Click
    window.addEventListener('pointerdown', (e) => {
      // Ignore clicks on UI elements
      if ((e.target as HTMLElement).closest('.unified-nav, .top-controls-container, .hud-overlay, .zen-toast')) {
        return;
      }

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(interactiveTargets, true);

      if (intersects.length > 0) {
        const hit = intersects[0];
        let obj: THREE.Object3D | null = hit.object;

        while (obj && !interactiveTargets.includes(obj)) {
          obj = obj.parent;
        }

        if (!obj) obj = hit.object;

        if (obj === bellMesh || obj.name.includes('Bell')) {
          strikeBell();
        } else if (obj === lanternMesh || obj.name.includes('Lantern')) {
          toggleLantern();
        } else if (obj === pondMesh || obj.name.includes('Pond')) {
          triggerPondRipple(hit.point);
        } else if (koiMeshes.includes(obj as THREE.Mesh) || obj.name.includes('Koi')) {
          triggerKoiInteraction(obj as THREE.Mesh);
        }
      } else {
        // Tap on open space chimes bell softly
        playZenBell();
      }
    });

    // --- 12. Camera Presets & Transitions ---
    interface CameraPreset {
      pos: THREE.Vector3;
      target: THREE.Vector3;
    }
    const presets: Record<string, CameraPreset> = {
      orbit: {
        pos: new THREE.Vector3(9, 6.5, 11),
        target: new THREE.Vector3(0, 0.5, 0),
      },
      bell: {
        pos: new THREE.Vector3(3.2, 3.8, 4.2),
        target: new THREE.Vector3(0.5, 2.0, 0),
      },
      pond: {
        pos: new THREE.Vector3(1.2, 7.5, 2.8),
        target: new THREE.Vector3(0, 0.2, 0),
      },
    };

    let targetCameraPos = camera.position.clone();
    let targetControlsTarget = controls.target.clone();
    let isTransitioningCamera = false;

    const transitionToPreset = (name: string) => {
      const preset = presets[name];
      if (!preset) return;

      targetCameraPos.copy(preset.pos);
      targetControlsTarget.copy(preset.target);
      isTransitioningCamera = true;

      document.querySelectorAll('.preset-btn[data-view]').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-view') === name);
      });

      controls.autoRotate = (name === 'orbit');
    };

    document.querySelectorAll('.preset-btn[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        if (view) transitionToPreset(view);
      });
    });

    // --- 13. Pranayama 6-Second Breath Guide Mode ---
    let breathGuideActive = false;
    const breatheToggleBtn = document.getElementById('breathe-toggle');

    const toggleBreatheMode = () => {
      breathGuideActive = !breathGuideActive;
      breatheToggleBtn?.classList.toggle('active', breathGuideActive);
      breathOverlay?.classList.toggle('hidden', !breathGuideActive);

      if (breathGuideActive) {
        showToast("🧘 Breathing mode engaged. Harmonize your breath with the island's rhythm.");
      } else {
        showToast("🧘 Breathing guide resting.");
      }
    };

    breatheToggleBtn?.addEventListener('click', toggleBreatheMode);

    // --- 14. Genetic Contemplation Feedback (Empty, Grounded, Noisy) ---
    let currentRating = localStorage.getItem('gzen_sanctuary_rating') || 'grounded';
    let floatSpeedMultiplier = 1.0;

    const applyContemplationRating = (rating: string) => {
      currentRating = rating;
      localStorage.setItem('gzen_sanctuary_rating', rating);

      document.querySelectorAll('.fb-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-rating') === rating);
      });

      if (rating === 'empty') {
        scene.fog = new THREE.FogExp2(warmCreamBg, 0.042);
        ambientLight.intensity = 1.15;
        sunLight.intensity = 1.6;
        floatSpeedMultiplier = 0.85;
        controls.autoRotateSpeed = 0.22;
        showToast("🪨 Empty: Atmospheric mist softened, contemplation space expanded.");
      } else if (rating === 'grounded') {
        scene.fog = new THREE.FogExp2(warmCreamBg, 0.028);
        ambientLight.intensity = 1.35;
        sunLight.intensity = 2.0;
        floatSpeedMultiplier = 1.0;
        controls.autoRotateSpeed = 0.35;
        showToast("🪷 Grounded: Harmonious golden equilibrium established.");
      } else if (rating === 'noisy') {
        scene.fog = new THREE.FogExp2(warmCreamBg, 0.022);
        ambientLight.intensity = 1.45;
        sunLight.intensity = 1.8;
        floatSpeedMultiplier = 0.55;
        controls.autoRotateSpeed = 0.12;
        showToast("🌪️ Noisy: Turbulence quelled. Island kinetics calmed to restore stillness.");
      }
    };

    document.querySelectorAll('.fb-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const rating = btn.getAttribute('data-rating');
        if (rating) applyContemplationRating(rating);
      });
    });

    // Apply saved rating on start
    applyContemplationRating(currentRating);

    // --- 15. Action Button Listeners ---
    document.getElementById('chime-btn')?.addEventListener('click', strikeBell);
    document.getElementById('lantern-btn')?.addEventListener('click', toggleLantern);
    document.getElementById('crane-btn')?.addEventListener('click', spawnOrigamiCrane);

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      const key = e.key.toLowerCase();
      if (key === 'b') strikeBell();
      else if (key === 'l') toggleLantern();
      else if (key === 'c') spawnOrigamiCrane();
      else if (key === '1') transitionToPreset('orbit');
      else if (key === '2') transitionToPreset('bell');
      else if (key === '3') transitionToPreset('pond');
      else if (e.code === 'Space') {
        e.preventDefault();
        toggleBreatheMode();
      }
    });

    // Window Resize Handler
    window.addEventListener('resize', () => {
      if (!container) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });

    // --- 16. The Living Render Loop ---
    const clock = new THREE.Clock();

    const renderLoop = () => {
      requestAnimationFrame(renderLoop);
      const elapsedTime = clock.getElapsedTime();
      const delta = clock.getDelta();

      // Island Breathing Kinematics (6-Second Harmonized Cycle)
      const breathPhase = (elapsedTime * floatSpeedMultiplier) % 6.0;
      const breathCycle = Math.sin((elapsedTime * floatSpeedMultiplier * Math.PI) / 3.0);
      islandGroup.position.y = breathCycle * 0.14;
      islandGroup.rotation.z = Math.sin(elapsedTime * 0.5) * 0.012;

      // Update Breath Overlay Text
      if (breathGuideActive && breathText) {
        if (breathPhase < 3.0) {
          breathText.textContent = `Inhale (${(3.0 - breathPhase).toFixed(1)}s)`;
        } else {
          breathText.textContent = `Exhale (${(6.0 - breathPhase).toFixed(1)}s)`;
        }
      }

      // Bell Physical Swing Damping
      if (bellMesh && Math.abs(bellSwingAngle) + Math.abs(bellSwingVelocity) > 0.001) {
        const k = 14; // Hooke spring stiffness
        const c = 2.2; // Damping
        const acceleration = -k * bellSwingAngle - c * bellSwingVelocity;
        bellSwingVelocity += acceleration * 0.016;
        bellSwingAngle += bellSwingVelocity * 0.016;
        bellMesh.rotation.z = bellSwingAngle;
      }

      // Soundwave Ring Expansion
      if (soundRingActive) {
        soundRingScale += 0.08;
        soundRingOpacity -= 0.014;
        soundRing.scale.set(soundRingScale, soundRingScale, soundRingScale);
        soundRingMat.opacity = Math.max(0, soundRingOpacity);
        if (soundRingOpacity <= 0) {
          soundRingActive = false;
        }
      }

      // Water Ripples Expansion
      for (let i = ripples.length - 1; i >= 0; i--) {
        const rip = ripples[i];
        rip.scale += 0.045;
        rip.opacity -= 0.018;
        rip.mesh.scale.set(rip.scale, rip.scale, rip.scale);
        (rip.mesh.material as THREE.MeshBasicMaterial).opacity = Math.max(0, rip.opacity);

        if (rip.opacity <= 0) {
          islandGroup.remove(rip.mesh);
          rip.mesh.geometry.dispose();
          (rip.mesh.material as THREE.Material).dispose();
          ripples.splice(i, 1);
        }
      }

      // Swimming Koi Fish Kinematics
      koiMeshes.forEach((koi, idx) => {
        const koiTime = elapsedTime * 0.6 + (idx * (Math.PI * 2 / 3));
        const pondRadius = 0.9 + (idx * 0.18);
        const kX = Math.cos(koiTime) * pondRadius;
        const kZ = Math.sin(koiTime) * pondRadius;
        
        koi.position.x = kX;
        koi.position.z = kZ;
        koi.position.y = 0.12 + Math.sin(elapsedTime * 2.5 + idx) * 0.02;

        // Fish Heading angle + natural body wiggle
        const heading = -koiTime + Math.PI / 2;
        koi.rotation.y = heading + Math.sin(elapsedTime * 4.0 + idx) * 0.15;
      });

      // Drifting Mist Clouds
      cloudMeshes.forEach((cloud, idx) => {
        cloud.position.y = (cloud.position.y || 2.5) + Math.sin(elapsedTime * 0.8 + idx) * 0.0015;
        cloud.rotation.y += 0.0012;
      });

      // Atmospheric Golden Motes Rising Float
      const positions = moteGeo.attributes.position.array as Float32Array;
      for (let i = 0; i < moteCount; i++) {
        positions[i * 3 + 1] += moteSpeeds[i];
        positions[i * 3] += Math.sin(elapsedTime + i) * 0.003;
        if (positions[i * 3 + 1] > 9) {
          positions[i * 3 + 1] = 0;
        }
      }
      moteGeo.attributes.position.needsUpdate = true;

      // Origami Cranes Flight Trajectory
      for (let i = cranes.length - 1; i >= 0; i--) {
        const crane = cranes[i];
        crane.progress += crane.speed;
        crane.group.position.lerpVectors(crane.start, crane.end, crane.progress);

        // Sinusoidal Wing Flapping
        const wingFlap = Math.sin(crane.progress * 45) * 0.2;
        crane.group.rotation.z = wingFlap;

        if (crane.progress >= 1.0) {
          scene.remove(crane.group);
          cranes.splice(i, 1);
        }
      }

      // Smooth Camera Lerp for Presets
      if (isTransitioningCamera) {
        camera.position.lerp(targetCameraPos, 0.05);
        controls.target.lerp(targetControlsTarget, 0.05);
        if (camera.position.distanceTo(targetCameraPos) < 0.05) {
          camera.position.copy(targetCameraPos);
          controls.target.copy(targetControlsTarget);
          isTransitioningCamera = false;
        }
      }

      // Raycast Hover Test
      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(interactiveTargets, true);

      if (intersects.length > 0) {
        const hit = intersects[0];
        let obj: THREE.Object3D | null = hit.object;
        while (obj && !interactiveTargets.includes(obj)) {
          obj = obj.parent;
        }
        if (!obj) obj = hit.object;

        if (obj !== hoveredObject) {
          hoveredObject = obj;
          renderer.domElement.style.cursor = 'pointer';

          if (targetTooltip && tooltipLabel) {
            if (obj === bellMesh || obj.name.includes('Bell')) {
              tooltipLabel.textContent = 'Singing Bell (Click to strike)';
            } else if (obj === lanternMesh || obj.name.includes('Lantern')) {
              tooltipLabel.textContent = 'Stone Lantern (Click to kindle)';
            } else if (obj === pondMesh || obj.name.includes('Pond')) {
              tooltipLabel.textContent = 'Reflecting Pond (Click to ripple)';
            } else if (obj.name.includes('Koi')) {
              tooltipLabel.textContent = 'Kohaku Koi (Click to guide)';
            }
            targetTooltip.classList.add('visible');
          }
        }
      } else {
        if (hoveredObject) {
          hoveredObject = null;
          renderer.domElement.style.cursor = 'default';
          targetTooltip?.classList.remove('visible');
        }
      }

      controls.update();
      renderer.render(scene, camera);
    };

    renderLoop();
  }
</script>

