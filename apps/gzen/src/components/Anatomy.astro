---
import { site } from "../data/paths";

const { anatomy } = site;
---

<section class="anatomy" id="anatomy" aria-labelledby="anatomy-title">
  <header class="head reveal">
    <p class="eyebrow">Section 01</p>
    <h2 class="section-title" id="anatomy-title">{anatomy.title}</h2>
    <p class="section-lead">{anatomy.lead}</p>
  </header>

  <div class="poles">
    <article class="pole pole-fire reveal reveal-d2">
      <p class="pole-label">{anatomy.fire.label}</p>
      <h3 class="pole-title">{anatomy.fire.title}</h3>
      <ul>
        {anatomy.fire.points.map((p) => <li>{p}</li>)}
      </ul>
    </article>

    <div class="bridge" aria-hidden="true">
      <span class="bridge-dot"></span>
      <span class="bridge-line"></span>
      <span class="bridge-dot"></span>
    </div>

    <article class="pole pole-peace reveal reveal-d3">
      <p class="pole-label">{anatomy.peace.label}</p>
      <h3 class="pole-title">{anatomy.peace.title}</h3>
      <ul>
        {anatomy.peace.points.map((p) => <li>{p}</li>)}
      </ul>
    </article>
  </div>
</section>

<style>
  .anatomy {
    padding: var(--space-section) 0 0;
  }

  .head {
    max-width: 36rem;
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .poles {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .poles {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem;
      align-items: stretch;
    }
  }

  .pole {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    backdrop-filter: blur(12px);
    overflow: hidden;
    transition:
      border-color 0.35s var(--ease),
      transform 0.4s var(--ease);
  }

  .pole::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.9;
  }

  .pole-fire::before {
    background: radial-gradient(
      120% 80% at 0% 0%,
      color-mix(in srgb, var(--accent-warm) 16%, transparent),
      transparent 55%
    );
  }

  .pole-peace::before {
    background: radial-gradient(
      120% 80% at 100% 0%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 55%
    );
  }

  .pole:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .pole-label {
    position: relative;
    margin: 0 0 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .pole-fire .pole-label {
    color: color-mix(in srgb, var(--accent-warm) 85%, var(--muted));
  }

  .pole-peace .pole-label {
    color: color-mix(in srgb, var(--accent) 85%, var(--muted));
  }

  .pole-title {
    position: relative;
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  ul {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .pole-fire li::before {
    background: color-mix(in srgb, var(--accent-warm) 70%, transparent);
  }

  .pole-peace li::before {
    background: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .bridge {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 0;
  }

  @media (min-width: 800px) {
    .bridge {
      display: flex;
    }
  }

  .bridge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .bridge-line {
    width: 1px;
    flex: 1;
    min-height: 3rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent-warm) 40%, transparent),
      var(--line-strong),
      color-mix(in srgb, var(--accent) 40%, transparent)
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .bridge-dot {
      animation: breath 3.5s ease-in-out infinite;
    }
  }
</style>
