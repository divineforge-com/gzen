---
import { site } from "../data/elements";
---

<footer class="foot reveal">
  <div class="foot-brand">
    <span class="mark">gZen</span>
    <span class="domain">gzen.io</span>
    <span class="sep" aria-hidden="true">◆</span>
    <span class="whisper">{site.originWhisper}</span>
  </div>
  <div class="foot-links">
    <a href="#elements">Elements (Z · E · N)</a>
    <span class="sep" aria-hidden="true">◆</span>
    <a href="#tribute">Fuel (BMC)</a>
    <span class="sep" aria-hidden="true">◆</span>
    <a href="https://divineforge.com" target="_blank" rel="noopener noreferrer">DivineForge</a>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding: 2.25rem 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.82rem;
    color: var(--dim);
  }

  .foot-brand,
  .foot-links {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .mark {
    color: var(--ink);
    font-weight: 550;
    letter-spacing: -0.03em;
    font-size: 0.95rem;
  }

  .domain {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }

  .whisper {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--dim);
    opacity: 0.8;
  }

  .sep {
    opacity: 0.45;
  }

  a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  a:hover,
  a:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--accent);
    outline: none;
  }

  @media (max-width: 480px) {
    .foot {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.85rem;
      padding: 1.75rem 0 0.85rem;
    }

    .foot-brand,
    .foot-links {
      justify-content: center;
    }
  }
</style>
