---
import type { Path } from "../data/paths";

interface Props {
  path: Path;
  index: number;
}

const { path, index } = Astro.props;
const delayClass = `reveal-d${Math.min(index + 1, 5)}`;
const poleLabel =
  path.pole === "G" ? "Fire" : path.pole === "Zen" ? "Peace" : "Flow";
---

<a
  class:list={["path", "reveal", delayClass]}
  href={path.href}
  data-path={path.letter}
  style={`--path-tone: ${path.tone}`}
>
  <div class="path-letter" aria-hidden="true">{path.letter}</div>

  <div class="path-body">
    <div class="path-meta">
      <span class="pole">{poleLabel}</span>
      <span class="host">{path.host}</span>
    </div>
    <h3 class="path-name">{path.name}</h3>
    <p class="path-blurb">{path.blurb}</p>
  </div>

  <span class="arrow" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
      <path
        d="M3 8h10M9 4l4 4-4 4"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .path {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    padding: clamp(1.2rem, 2.8vw, 1.55rem) clamp(1.15rem, 2.5vw, 1.5rem);
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition:
      border-color 0.3s var(--ease),
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      background 0.3s var(--ease);
  }

  .path::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--path-tone) 14%, transparent) 0%,
      transparent 42%
    );
    opacity: 0.7;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }

  .path:hover,
  .path:focus-visible {
    border-color: color-mix(in srgb, var(--path-tone) 40%, var(--line-strong));
    transform: translateX(4px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.03),
      0 16px 40px rgba(0, 0, 0, 0.35),
      0 0 40px color-mix(in srgb, var(--path-tone) 10%, transparent);
    background: var(--bg-elevated);
    outline: none;
  }

  .path:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .path-letter {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(2.75rem, 6vw, 3.25rem);
    height: clamp(2.75rem, 6vw, 3.25rem);
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--path-tone) 35%, var(--line));
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--path-tone);
    background: color-mix(in srgb, var(--path-tone) 8%, transparent);
    flex-shrink: 0;
  }

  .path-body {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .path-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-bottom: 0.35rem;
  }

  .pole {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--path-tone) 80%, var(--muted));
  }

  .host {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--dim);
    transition: color 0.2s var(--ease);
  }

  .path-name {
    margin: 0 0 0.3rem;
    font-size: clamp(1.25rem, 2.5vw, 1.45rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .path-blurb {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 38ch;
  }

  .arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--dim);
    flex-shrink: 0;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.3s var(--ease);
  }

  .path:hover .host,
  .path:focus-visible .host {
    color: var(--muted);
  }

  .path:hover .arrow,
  .path:focus-visible .arrow {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--path-tone) 40%, var(--line));
    background: color-mix(in srgb, var(--path-tone) 12%, transparent);
    transform: translateX(3px);
  }

  @media (max-width: 480px) {
    .path {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }

    .arrow {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.15rem;
    }

    .path-blurb {
      max-width: none;
    }
  }
</style>
