---
import type { Path } from "../data/paths";

interface Props {
  path: Path;
  index: number;
}

const { path, index } = Astro.props;
const delayClass = `reveal-d${Math.min(index + 1, 5)}`;
const poleLabel =
  path.pole === "G" ? "Fire" : path.pole === "Zen" ? "Peace" : "Fire + Peace";
---

<a
  class:list={["path", "reveal", delayClass]}
  href={path.href}
  data-path={path.letter}
  style={`--path-tone: ${path.tone}`}
>
  <!-- Ambient in-card sacred geometric watermark vector -->
  <div class:list={["path-watermark", `path-watermark-${path.letter.toLowerCase()}`]} aria-hidden="true">
    {
      path.letter === "Z" ? (
        <!-- Z · Sacred Enso Tri-Monad Watermark -->
        <svg class="wm-svg wm-svg-z" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle class="wm-ring wm-ring-outer" cx="100" cy="100" r="88" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" opacity="0.4"/>
          <circle class="wm-ring wm-ring-mid" cx="100" cy="100" r="66" stroke="currentColor" stroke-width="1.2" opacity="0.6"/>
          <circle class="wm-ring wm-ring-inner" cx="100" cy="100" r="44" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.5"/>
          <polygon class="wm-tri" points="100,24 165,138 35,138" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" opacity="0.7"/>
          <polygon class="wm-tri-inv" points="100,176 35,62 165,62" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 4" opacity="0.3"/>
          <path class="wm-enso" d="M100,34 A66,66 0 1,1 42,76" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
          <line x1="100" y1="6" x2="100" y2="194" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 8" opacity="0.35"/>
          <line x1="6" y1="100" x2="194" y2="100" stroke="currentColor" stroke-width="0.6" stroke-dasharray="4 8" opacity="0.35"/>
          <circle cx="100" cy="24" r="3" fill="currentColor"/>
          <circle cx="165" cy="138" r="3" fill="currentColor"/>
          <circle cx="35" cy="138" r="3" fill="currentColor"/>
          <circle cx="100" cy="100" r="2" fill="currentColor"/>
        </svg>
      ) : path.letter === "E" ? (
        <!-- E · Sacred Octahedron & Rhombic Capital Lattice Watermark -->
        <svg class="wm-svg wm-svg-e" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon class="wm-diamond wm-diamond-outer" points="100,12 176,72 100,188 24,72" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" opacity="0.75"/>
          <polygon class="wm-diamond wm-diamond-mid" points="100,38 152,80 100,158 48,80" stroke="currentColor" stroke-width="1" stroke-dasharray="6 4" opacity="0.55"/>
          <polygon class="wm-diamond wm-diamond-inner" points="100,64 128,88 100,128 72,88" stroke="currentColor" stroke-width="1.2" opacity="0.7"/>
          <line x1="100" y1="12" x2="100" y2="188" stroke="currentColor" stroke-width="1.2" opacity="0.7"/>
          <line x1="24" y1="72" x2="176" y2="72" stroke="currentColor" stroke-width="1.2" opacity="0.7"/>
          <line x1="24" y1="72" x2="100" y2="12" stroke="currentColor" stroke-width="0.75" opacity="0.4"/>
          <line x1="176" y1="72" x2="100" y2="188" stroke="currentColor" stroke-width="0.75" opacity="0.4"/>
          <line x1="24" y1="72" x2="100" y2="188" stroke="currentColor" stroke-width="0.75" opacity="0.4"/>
          <line x1="176" y1="72" x2="100" y2="12" stroke="currentColor" stroke-width="0.75" opacity="0.4"/>
          <path d="M100,12 L100,2 M100,188 L100,198 M24,72 L12,72 M176,72 L188,72" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>
          <circle cx="100" cy="12" r="3.5" fill="currentColor"/>
          <circle cx="176" cy="72" r="3.5" fill="currentColor"/>
          <circle cx="100" cy="188" r="3.5" fill="currentColor"/>
          <circle cx="24" cy="72" r="3.5" fill="currentColor"/>
          <circle cx="100" cy="72" r="2.5" fill="currentColor"/>
        </svg>
      ) : (
        <!-- N · Sacred Icosahedral Neural Constellation Watermark -->
        <svg class="wm-svg wm-svg-n" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon class="wm-neural-poly" points="100,18 165,55 165,130 100,167 35,130 35,55" stroke="currentColor" stroke-width="1.4" stroke-dasharray="6 4" opacity="0.6"/>
          <polygon class="wm-neural-inner" points="100,42 142,66 142,118 100,142 58,118 58,66" stroke="currentColor" stroke-width="0.8" opacity="0.4"/>
          <line x1="100" y1="18" x2="100" y2="167" stroke="currentColor" stroke-width="1.2" opacity="0.65"/>
          <line x1="35" y1="55" x2="165" y2="130" stroke="currentColor" stroke-width="1" opacity="0.5"/>
          <line x1="35" y1="130" x2="165" y2="55" stroke="currentColor" stroke-width="1" opacity="0.5"/>
          <line x1="100" y1="18" x2="165" y2="130" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" opacity="0.4"/>
          <line x1="100" y1="18" x2="35" y2="130" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" opacity="0.4"/>
          <line x1="100" y1="167" x2="165" y2="55" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" opacity="0.4"/>
          <line x1="100" y1="167" x2="35" y2="55" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 4" opacity="0.4"/>
          <circle cx="100" cy="18" r="7" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
          <circle cx="165" cy="55" r="7" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
          <circle cx="165" cy="130" r="7" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
          <circle cx="100" cy="167" r="7" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
          <circle cx="35" cy="130" r="7" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
          <circle cx="35" cy="55" r="7" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.5"/>
          <circle cx="100" cy="18" r="3.5" fill="currentColor"/>
          <circle cx="165" cy="55" r="3.5" fill="currentColor"/>
          <circle cx="165" cy="130" r="3.5" fill="currentColor"/>
          <circle cx="100" cy="167" r="3.5" fill="currentColor"/>
          <circle cx="35" cy="130" r="3.5" fill="currentColor"/>
          <circle cx="35" cy="55" r="3.5" fill="currentColor"/>
          <circle cx="100" cy="92.5" r="12" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
          <circle cx="100" cy="92.5" r="4" fill="currentColor"/>
        </svg>
      )
    }
  </div>

  <!-- Primary Sacred Geometric Badge & Interaction Slot -->
  <div class="path-icon" aria-hidden="true">
    {
      path.letter === "Z" ? (
        <!-- Zen · Sacred Enso Tri-Monad Badge -->
        <svg class="portal-svg portal-svg-z" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle class="ring-outer" cx="22" cy="22" r="18" stroke="currentColor" stroke-width="1.2" stroke-dasharray="84 16" stroke-linecap="round"/>
          <circle class="ring-mid" cx="22" cy="22" r="13" stroke="currentColor" stroke-width="0.8" stroke-dasharray="3 4" opacity="0.6"/>
          <polygon class="tri-core" points="22,7 34.5,28.5 9.5,28.5" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" opacity="0.8"/>
          <path class="enso-curve" d="M22,12 A10,10 0 1,1 14,26" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle class="node-tip node-tip-t" cx="22" cy="7" r="1.5" fill="currentColor"/>
          <circle class="node-tip node-tip-r" cx="34.5" cy="28.5" r="1.5" fill="currentColor"/>
          <circle class="node-tip node-tip-l" cx="9.5" cy="28.5" r="1.5" fill="currentColor"/>
          <circle class="core-singularity" cx="22" cy="21" r="1.5" fill="currentColor"/>
        </svg>
      ) : path.letter === "E" ? (
        <!-- Economy · Sacred Octahedron & Rhombic Capital Lattice Badge -->
        <svg class="portal-svg portal-svg-e" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="diamond-facet diamond-outer" d="M22,4 L36,17 L22,40 L8,17 Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <line class="diamond-axis-v" x1="22" y1="4" x2="22" y2="40" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
          <line class="diamond-axis-h" x1="8" y1="17" x2="36" y2="17" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
          <polygon class="diamond-facet diamond-inner" points="22,10 30,17 22,29 14,17" stroke="currentColor" stroke-width="1" stroke-dasharray="3 2" opacity="0.85"/>
          <path class="alloc-ray" d="M22,4 L22,1 M22,40 L22,43 M8,17 L5,17 M36,17 L39,17" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <circle class="diamond-node" cx="22" cy="4" r="1.5" fill="currentColor"/>
          <circle class="diamond-node" cx="36" cy="17" r="1.5" fill="currentColor"/>
          <circle class="diamond-node" cx="22" cy="40" r="1.5" fill="currentColor"/>
          <circle class="diamond-node" cx="8" cy="17" r="1.5" fill="currentColor"/>
          <circle class="core-singularity" cx="22" cy="17" r="1.5" fill="currentColor"/>
        </svg>
      ) : (
        <!-- Neural · Sacred Icosahedral Neural Constellation Badge -->
        <svg class="portal-svg portal-svg-n" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon class="neural-poly" points="22,6 35,13.5 35,28.5 22,36 9,28.5 9,13.5" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" opacity="0.6"/>
          <line class="neural-chord chord-1" x1="22" y1="6" x2="22" y2="21" stroke="currentColor" stroke-width="1.1"/>
          <line class="neural-chord chord-2" x1="35" y1="13.5" x2="22" y2="21" stroke="currentColor" stroke-width="1.1"/>
          <line class="neural-chord chord-3" x1="35" y1="28.5" x2="22" y2="21" stroke="currentColor" stroke-width="1.1"/>
          <line class="neural-chord chord-4" x1="22" y1="36" x2="22" y2="21" stroke="currentColor" stroke-width="1.1"/>
          <line class="neural-chord chord-5" x1="9" y1="28.5" x2="22" y2="21" stroke="currentColor" stroke-width="1.1"/>
          <line class="neural-chord chord-6" x1="9" y1="13.5" x2="22" y2="21" stroke="currentColor" stroke-width="1.1"/>
          <line class="neural-chord chord-diag" x1="9" y1="13.5" x2="35" y2="28.5" stroke="currentColor" stroke-width="0.75" opacity="0.4"/>
          <circle class="neural-node" cx="22" cy="6" r="2" stroke="currentColor" stroke-width="1" fill="var(--card-solid)"/>
          <circle class="neural-node" cx="35" cy="13.5" r="2" stroke="currentColor" stroke-width="1" fill="var(--card-solid)"/>
          <circle class="neural-node" cx="35" cy="28.5" r="2" stroke="currentColor" stroke-width="1" fill="var(--card-solid)"/>
          <circle class="neural-node" cx="22" cy="36" r="2" stroke="currentColor" stroke-width="1" fill="var(--card-solid)"/>
          <circle class="neural-node" cx="9" cy="28.5" r="2" stroke="currentColor" stroke-width="1" fill="var(--card-solid)"/>
          <circle class="neural-node" cx="9" cy="13.5" r="2" stroke="currentColor" stroke-width="1" fill="var(--card-solid)"/>
          <circle class="neural-ring" cx="22" cy="21" r="4.5" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 2"/>
          <circle class="core-singularity" cx="22" cy="21" r="2" fill="currentColor"/>
        </svg>
      )
    }
  </div>

  <div class="path-body">
    <div class="path-meta">
      <span class="pole">{poleLabel}</span>
      <span class="geo-signature">{path.geometrySymbol} {path.geometryName}</span>
      <span class="host">{path.host}</span>
    </div>
    
    <h3 class="path-name">
      <span class="path-letter-mark">{path.letter} ·</span> {path.name}
      <span class="path-subname">{path.subname}</span>
    </h3>
    
    <p class="path-blurb">{path.blurb}</p>
    
    <p class="path-advocacy">{path.advocacy}</p>

    <!-- Fused daily protocol intro per portal -->
    <div class="path-protocol">
      <span class="protocol-tag">{path.protocolPillar}</span>
      <span class="protocol-detail">{path.protocolDetail}</span>
    </div>
  </div>

  <span class="arrow" aria-hidden="true">
    <kbd class="key-hint">{path.shortcut}</kbd>
    <span class="teleport-label">Teleport</span>
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
      <path
        d="M3 8h10M9 4l4 4-4 4"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .path {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: flex-start;
    gap: clamp(0.9rem, 2.5vw, 1.75rem);
    padding: clamp(1.2rem, 3vw, 1.85rem) clamp(1.1rem, 2.8vw, 1.75rem);
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    box-shadow:
      0 8px 32px -4px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12),
      inset 0 0 28px 0 color-mix(in srgb, var(--path-tone) 5%, transparent);
    overflow: hidden;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    will-change: transform, box-shadow;
    transition:
      border-color 0.3s var(--ease),
      background 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .path::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--path-tone);
    opacity: 0.75;
    transition: opacity 0.3s var(--ease), height 0.3s var(--ease);
    z-index: 1;
  }

  /* Dynamic Specular Sheen Layer (Follows Mouse & Touch) */
  .path::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(
      440px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--path-tone) 16%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    z-index: 0;
  }

  .path:hover,
  .path:focus-visible,
  .path.is-touching {
    border-color: color-mix(in srgb, var(--path-tone) 50%, var(--line-strong));
    background: var(--card-hover);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 14px 42px -6px color-mix(in srgb, var(--path-tone) 24%, transparent),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.16),
      inset 0 0 32px 0 color-mix(in srgb, var(--path-tone) 10%, transparent);
    outline: none;
  }

  .path:hover::before,
  .path:focus-visible::before,
  .path.is-touching::before {
    opacity: 1;
    height: 3px;
  }

  .path:hover::after,
  .path:focus-visible::after,
  .path.is-touching::after {
    opacity: 1;
  }

  /* Ambient In-Card Sacred Watermark */
  .path-watermark {
    position: absolute;
    right: -1.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(160px, 24vw, 240px);
    height: clamp(160px, 24vw, 240px);
    pointer-events: none;
    opacity: 0.12;
    color: var(--path-tone);
    z-index: 0;
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
    will-change: transform, opacity;
  }

  .wm-svg {
    width: 100%;
    height: 100%;
  }

  .path:hover .path-watermark,
  .path:focus-visible .path-watermark,
  .path.is-touching .path-watermark {
    opacity: 0.28;
    transform: translateY(-50%) scale(1.06) rotate(3deg);
  }

  /* Primary Sacred Geometric Badge */
  .path-icon {
    display: grid;
    place-items: center;
    width: clamp(2.6rem, 5vw, 3.1rem);
    height: clamp(2.6rem, 5vw, 3.1rem);
    padding: 0.35rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--path-tone) 8%, var(--card-solid));
    color: color-mix(in srgb, var(--path-tone) 90%, var(--ink));
    flex-shrink: 0;
    margin-top: 0.15rem;
    position: relative;
    z-index: 1;
    transition:
      border-color 0.3s var(--ease),
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .portal-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .path:hover .path-icon,
  .path:focus-visible .path-icon,
  .path.is-touching .path-icon {
    border-color: color-mix(in srgb, var(--path-tone) 55%, var(--line));
    background: color-mix(in srgb, var(--path-tone) 16%, var(--card-solid));
    color: var(--path-tone);
    transform: scale(1.06);
    box-shadow: 0 0 16px color-mix(in srgb, var(--path-tone) 25%, transparent);
  }

  .path-body {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .path-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pole {
    color: var(--path-tone);
    font-weight: 600;
  }

  .geo-signature {
    color: var(--dim);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    padding: 0.08rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--card-solid) 40%, transparent);
  }

  .host {
    color: var(--dim);
    transition: color 0.2s var(--ease);
  }

  .path-name {
    margin: 0 0 0.4rem;
    font-size: clamp(1.35rem, 2.8vw, 1.6rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .path-letter-mark {
    color: var(--path-tone);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .path-subname {
    font-size: 0.85rem;
    font-weight: 400;
    font-family: var(--font-mono);
    color: var(--dim);
    letter-spacing: 0;
  }

  .path-blurb {
    margin: 0 0 0.5rem;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.5;
    font-weight: 450;
  }

  .path-advocacy {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .path-protocol {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding: 0.55rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .protocol-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--path-tone);
    white-space: nowrap;
  }

  .protocol-detail {
    color: var(--muted);
  }

  .key-hint {
    display: none;
    padding: 0.05rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--dim);
    background: color-mix(in srgb, var(--card-solid) 60%, transparent);
  }

  .teleport-label {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-right: 0.3rem;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--dim);
    flex-shrink: 0;
    margin-top: 0.15rem;
    background: color-mix(in srgb, var(--card-solid) 30%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.3s var(--ease);
  }

  .path:hover .host,
  .path:focus-visible .host {
    color: var(--muted);
  }

  .path:hover .arrow,
  .path:focus-visible .arrow,
  .path.is-touching .arrow {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--path-tone) 45%, var(--line));
    background: color-mix(in srgb, var(--path-tone) 14%, var(--card-solid));
    transform: translateX(3px);
  }

  .path:hover .teleport-label {
    color: var(--ink);
  }

