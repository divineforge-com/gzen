---
import type { Path } from "../data/paths";

interface Props {
  path: Path;
  index: number;
}

const { path, index } = Astro.props;
const delayClass = `reveal-d${Math.min(index + 1, 5)}`;
const poleLabel =
  path.pole === "G" ? "Fire" : path.pole === "Zen" ? "Peace" : "Fire + Peace";
---

<a
  class:list={["path", "reveal", delayClass]}
  href={path.href}
  data-path={path.letter}
  style={`--path-tone: ${path.tone}`}
>
  <!-- Symbolic glyph icon for each Z.E.N. portal -->
  <div class="path-icon" aria-hidden="true">
    {
      path.letter === "Z" ? (
        <!-- Zen · Enso Circle + Vitality Spark -->
        <svg class="portal-svg portal-svg-z" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle class="ring-outer" cx="20" cy="20" r="14" stroke="currentColor" stroke-width="1.25" stroke-dasharray="72 16" stroke-linecap="round"/>
          <path class="ring-wave" d="M10 26c3-4 6-4 10 0 3 3 7 3 10 0" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
          <circle class="ring-core" cx="20" cy="20" r="3" stroke="currentColor" stroke-width="1"/>
        </svg>
      ) : path.letter === "E" ? (
        <!-- Economy · Capital Growth Geometric Diamond -->
        <svg class="portal-svg portal-svg-e" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path class="diamond-head" d="M20 6l8 12H12l8-12z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
          <path class="diamond-stem" d="M20 18v16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <path class="diamond-chevron" d="M14 28l6-4 6 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          <circle class="diamond-node-l" cx="11" cy="11" r="1.5" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
          <circle class="diamond-node-r" cx="29" cy="11" r="1.5" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
        </svg>
      ) : (
        <!-- Neural · Signal & Syntax Knowledge Node Network -->
        <svg class="portal-svg portal-svg-n" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle class="node-top" cx="20" cy="10" r="3" stroke="currentColor" stroke-width="1.25"/>
          <circle class="node-bl" cx="10" cy="28" r="3" stroke="currentColor" stroke-width="1.25"/>
          <circle class="node-br" cx="30" cy="28" r="3" stroke="currentColor" stroke-width="1.25"/>
          <path class="node-links" d="M18 12l-6 13M22 12l6 13M13 28h14" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.7"/>
          <circle class="node-core" cx="20" cy="20" r="1.5" fill="currentColor"/>
        </svg>
      )
    }
  </div>

  <!-- Z.E.N. letter chip & desktop key hint -->
  <span class="path-letter-chip" aria-hidden="true">
    {path.letter}
    <kbd class="key-hint">{path.shortcut}</kbd>
  </span>

  <div class="path-body">
    <div class="path-meta">
      <span class="pole">{poleLabel}</span>
      <span class="host">{path.host}</span>
    </div>
    
    <h3 class="path-name">
      {path.name}
      <span class="path-subname">{path.subname}</span>
    </h3>
    
    <p class="path-blurb">{path.blurb}</p>
    
    <p class="path-advocacy">{path.advocacy}</p>

    <!-- Fused daily protocol intro per portal -->
    <div class="path-protocol">
      <span class="protocol-tag">{path.protocolPillar}</span>
      <span class="protocol-detail">{path.protocolDetail}</span>
    </div>
  </div>

  <span class="arrow" aria-hidden="true">
    <span class="teleport-label">Teleport</span>
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
      <path
        d="M3 8h10M9 4l4 4-4 4"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .path {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: flex-start;
    gap: clamp(0.9rem, 2.5vw, 1.75rem);
    padding: clamp(1.2rem, 3vw, 1.85rem) clamp(1.1rem, 2.8vw, 1.75rem);
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    box-shadow:
      0 4px 24px -2px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
      inset 0 0 24px 0 color-mix(in srgb, var(--path-tone) 5%, transparent);
    overflow: hidden;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
    will-change: transform, box-shadow;
    transition:
      border-color 0.3s var(--ease),
      background 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .path::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--path-tone);
    opacity: 0.7;
    transition: opacity 0.3s var(--ease), height 0.3s var(--ease);
    z-index: 1;
  }

  /* Dynamic Specular Sheen Layer (Follows Mouse & Touch) */
  .path::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--path-tone) 15%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    z-index: 0;
  }

  .path:hover,
  .path:focus-visible,
  .path.is-touching {
    border-color: color-mix(in srgb, var(--path-tone) 45%, var(--line-strong));
    background: var(--card-hover);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 12px 36px -6px color-mix(in srgb, var(--path-tone) 20%, transparent),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12),
      inset 0 0 24px 0 color-mix(in srgb, var(--path-tone) 8%, transparent);
    outline: none;
  }

  .path:hover::before,
  .path:focus-visible::before,
  .path.is-touching::before {
    opacity: 1;
    height: 3px;
  }

  .path:hover::after,
  .path:focus-visible::after,
  .path.is-touching::after {
    opacity: 1;
  }

  .path-icon {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.35rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--path-tone) 6%, transparent);
    color: color-mix(in srgb, var(--path-tone) 85%, var(--ink));
    flex-shrink: 0;
    transition:
      border-color 0.3s var(--ease),
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .path:hover .path-icon,
  .path:focus-visible .path-icon {
    border-color: color-mix(in srgb, var(--path-tone) 40%, var(--line));
    background: color-mix(in srgb, var(--path-tone) 14%, transparent);
    color: var(--path-tone);
    transform: scale(1.05);
  }

  .path-letter-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 600;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--path-tone) 10%, var(--card));
    border: 1px solid color-mix(in srgb, var(--path-tone) 30%, var(--line));
    color: var(--path-tone);
    flex-shrink: 0;
    margin-top: 0.15rem;
    transition: transform 0.25s var(--ease);
  }

  .path:hover .path-letter-chip {
    transform: scale(1.06);
  }

  @media (min-width: 640px) {
    .path-icon {
      display: grid;
      place-items: center;
      margin-top: 0.15rem;
    }
    .path-letter-chip {
      display: none;
    }
  }

  .path-body {
    min-width: 0;
  }

  .path-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pole {
    color: var(--path-tone);
    font-weight: 600;
  }

  .host {
    color: var(--dim);
    transition: color 0.2s var(--ease);
  }

  .path-name {
    margin: 0 0 0.4rem;
    font-size: clamp(1.35rem, 2.8vw, 1.6rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .path-subname {
    font-size: 0.85rem;
    font-weight: 400;
    font-family: var(--font-mono);
    color: var(--dim);
    letter-spacing: 0;
  }

  .path-blurb {
    margin: 0 0 0.5rem;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.5;
    font-weight: 450;
  }

  .path-advocacy {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .path-protocol {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding: 0.55rem 0.85rem;
    background: color-mix(in srgb, var(--card-solid) 35%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .protocol-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--path-tone);
    white-space: nowrap;
  }

  .protocol-detail {
    color: var(--muted);
  }

  .key-hint {
    display: none;
    margin-left: 0.25rem;
    padding: 0.05rem 0.3rem;
    font-size: 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    color: var(--muted);
  }

  .teleport-label {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-right: 0.4rem;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--dim);
    flex-shrink: 0;
    margin-top: 0.15rem;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.3s var(--ease);
  }

  .path:hover .host,
  .path:focus-visible .host {
    color: var(--muted);
  }

  .path:hover .arrow,
  .path:focus-visible .arrow {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--path-tone) 40%, var(--line));
    background: color-mix(in srgb, var(--path-tone) 12%, transparent);
    transform: translateX(3px);
  }

  .path:hover .teleport-label {
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .key-hint {
      display: inline-block;
    }
    .teleport-label {
      display: inline-block;
    }
    .arrow {
      width: auto;
      padding: 0 0.85rem;
      height: 2.35rem;
      display: flex;
      gap: 0.35rem;
    }
  }
</style>
