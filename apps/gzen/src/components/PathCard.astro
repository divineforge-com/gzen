---
import type { Path } from "../data/paths";

interface Props {
  path: Path;
  index: number;
}

const { path, index } = Astro.props;
const delayClass = `reveal-d${Math.min(index + 1, 5)}`;
const poleLabel =
  path.pole === "G" ? "Fire" : path.pole === "Zen" ? "Peace" : "Fire + Peace";

// Strategic flow tags — absorbed from Framework section
const flowTag: Record<string, string> = {
  K: "Patient progress &middot; vitality compounds",
  I: "Urgent action &middot; windows close",
  L: "Observe first &middot; then execute",
  O: "Hard stop &middot; stillness is the strategy",
};
---

<a
  class:list={["path", "reveal", delayClass]}
  href={path.href}
  data-path={path.letter}
  style={`--path-tone: ${path.tone}`}
  title={`Go to ${path.name} (Press '${path.letter}')`}
  aria-keyshortcuts={path.letter}
>
  <!-- Symbolic icon for each K.I.L.O. portal -->
  <div class="path-icon" aria-hidden="true">
    {
      path.letter === "K" ? (
        <!-- Ki · Vitality — stylised pulse / leaf -->
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 4c-4 8-6 16-4 24" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <path d="M20 4c4 8 6 16 4 24" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <circle cx="20" cy="30" r="5" stroke="currentColor" stroke-width="1.25"/>
          <path d="M12 20c2-2 8-2 16 0" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" opacity="0.5"/>
        </svg>
      ) : path.letter === "I" ? (
        <!-- Invest · Capital — geometric upward diamond / growth -->
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 6l8 12H12l8-12z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
          <path d="M20 18v16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <path d="M14 28l6-4 6 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="11" cy="11" r="1.5" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
          <circle cx="29" cy="11" r="1.5" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
        </svg>
      ) : path.letter === "L" ? (
        <!-- Learn · Knowledge — open book / light -->
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 8h10l2 4h12v16H8V8z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
          <path d="M20 12v16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <circle cx="14" cy="20" r="3" stroke="currentColor" stroke-width="1.25"/>
          <path d="M15 19l4-4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
          <circle cx="14" cy="20" r="7" stroke="currentColor" stroke-width="0.6" opacity="0.4"/>
        </svg>
      ) : (
        <!-- Om · Stillness — enso circle + wave -->
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="14" stroke="currentColor" stroke-width="1.25" stroke-dasharray="72 16" stroke-linecap="round"/>
          <path d="M10 26c3-4 6-4 10 0 3 3 7 3 10 0" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
          <circle cx="20" cy="20" r="3" stroke="currentColor" stroke-width="1"/>
        </svg>
      )
    }
  </div>

  <!-- K.I.L.O. letter chip for scannability -->
  <span class="path-letter-chip" aria-hidden="true">{path.letter}</span>

  <div class="path-body">
    <div class="path-meta">
      <span class="pole">{poleLabel}</span>
      <span class="host">{path.host}</span>
    </div>
    <h3 class="path-name">{path.name}</h3>
    <p class="path-blurb">{path.blurb}</p>
    <p class="path-flow" set:html={flowTag[path.letter] || ""}></p>
  </div>

  <span class="arrow" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
      <path
        d="M3 8h10M9 4l4 4-4 4"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .path {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    padding: clamp(1.2rem, 2.8vw, 1.55rem) clamp(1.15rem, 2.5vw, 1.5rem);
    text-decoration: none;
    color: inherit;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition:
      border-color 0.3s var(--ease),
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      background 0.3s var(--ease);
  }

  .path::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      color-mix(in srgb, var(--path-tone) 14%, transparent) 0%,
      transparent 42%
    );
    opacity: 0.7;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }

  .path:hover,
  .path:focus-visible {
    border-color: color-mix(in srgb, var(--path-tone) 40%, var(--line-strong));
    transform: translateX(4px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.03),
      0 16px 40px rgba(0, 0, 0, 0.35),
      0 0 40px color-mix(in srgb, var(--path-tone) 10%, transparent);
    background: var(--bg-elevated);
    outline: none;
  }

  .path:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  /* -------- Symbolic icon -------- */
  .path-icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: clamp(3rem, 7vw, 3.75rem);
    height: clamp(3rem, 7vw, 3.75rem);
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--path-tone) 30%, var(--line));
    color: var(--path-tone);
    background: color-mix(in srgb, var(--path-tone) 8%, transparent);
    flex-shrink: 0;
    transition:
      border-color 0.35s var(--ease),
      background 0.35s var(--ease),
      transform 0.35s var(--ease);
  }

  .path:hover .path-icon,
  .path:focus-visible .path-icon {
    border-color: color-mix(in srgb, var(--path-tone) 50%, var(--line-strong));
    background: color-mix(in srgb, var(--path-tone) 14%, transparent);
    transform: scale(1.05);
  }

  .path-icon svg {
    width: 60%;
    height: 60%;
  }

  /* K·I·L·O letter chip — visible acronym reinforcement */
  .path-letter-chip {
    position: absolute;
    top: clamp(0.5rem, 1.5vw, 0.75rem);
    right: clamp(0.5rem, 1.5vw, 0.75rem);
    z-index: 1;
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--path-tone) 18%, transparent);
    pointer-events: none;
    transition: color 0.35s var(--ease);
  }

  .path:hover .path-letter-chip,
  .path:focus-visible .path-letter-chip {
    color: color-mix(in srgb, var(--path-tone) 28%, transparent);
  }

  .path-body {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .path-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-bottom: 0.35rem;
  }

  .pole {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--path-tone) 80%, var(--muted));
  }

  .host {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--dim);
    transition: color 0.2s var(--ease);
  }

  .path-name {
    margin: 0 0 0.3rem;
    font-size: clamp(1.25rem, 2.5vw, 1.45rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .path-blurb {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 38ch;
  }

  /* Strategic flow tag — absorbed from Framework */
  .path-flow {
    margin: 0.55rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    transition: color 0.3s var(--ease);
  }

  .path:hover .path-flow,
  .path:focus-visible .path-flow {
    color: color-mix(in srgb, var(--path-tone) 70%, var(--muted));
    opacity: 1;
  }

  .arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--dim);
    flex-shrink: 0;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.3s var(--ease);
  }

  .path:hover .host,
  .path:focus-visible .host {
    color: var(--muted);
  }

  .path:hover .arrow,
  .path:focus-visible .arrow {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--path-tone) 40%, var(--line));
    background: color-mix(in srgb, var(--path-tone) 12%, transparent);
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .path {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto;
      gap: clamp(0.75rem, 2vw, 1.25rem);
      padding: clamp(1rem, 2.5vw, 1.3rem);
    }

    .path-icon {
      width: clamp(2.5rem, 10vw, 3.25rem);
      height: clamp(2.5rem, 10vw, 3.25rem);
      border-radius: var(--radius-sm);
      align-self: start;
      margin-top: 0.15rem;
    }

    .path-icon svg {
      width: 55%;
      height: 55%;
    }

    /* Hide arrow on mobile — entire card is tappable */
    .arrow {
      display: none;
    }

    .path-blurb {
      max-width: none;
    }

    .path-flow {
      font-size: 0.6rem;
      letter-spacing: 0.06em;
      margin-top: 0.45rem;
    }

    .path-meta {
      gap: 0.35rem 0.65rem;
      margin-bottom: 0.25rem;
    }

    .path-name {
      font-size: 1.15rem;
    }
  }

  /* Tablet — keep arrow but tighten */
  @media (min-width: 641px) and (max-width: 900px) {
    .path-icon {
      width: clamp(2.75rem, 5vw, 3.25rem);
      height: clamp(2.75rem, 5vw, 3.25rem);
    }

    .path {
      gap: clamp(0.9rem, 2vw, 1.5rem);
    }
  }
</style>
