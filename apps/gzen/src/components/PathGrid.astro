---
import { paths } from "../data/paths";
import PathCard from "./PathCard.astro";
---

<section class="paths" id="paths" aria-label="Three portals of gZen">
  <header class="paths-head reveal">
    <div>
      <p class="eyebrow">Z · E · N</p>
      <h2 class="section-title">Three portals. One sovereign practice.</h2>
      <p class="section-lead">
        Two poles — <strong>Fire</strong> (drive), <strong>Peace</strong> (stillness), and the <strong>Flow</strong> between them.
        Execute where it compounds. Rest where it protects.
      </p>
      <p class="section-rhythm">
        Every portal anchors a sovereign capability: somatic vitality, capital architecture, or neural command syntax.
      </p>
      <p class="section-hint" aria-hidden="true">
        Press <kbd>Z</kbd> <kbd>E</kbd> <kbd>N</kbd> to teleport.
      </p>
    </div>
  </header>

  <div class="grid">
    {paths.map((path, i) => <PathCard path={path} index={i} />)}
  </div>
</section>

<style>
  .paths {
    padding: var(--space-section) 0 0;
  }

  .paths-head {
    margin-bottom: clamp(2rem, 5vw, 2.75rem);
    max-width: 40rem;
  }

  .section-lead strong {
    color: var(--ink);
    font-weight: 550;
  }

  .section-rhythm {
    margin: 0.65rem 0 0;
    color: var(--dim);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .section-hint {
    margin: 0.5rem 0 0;
    color: var(--dim);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .section-hint kbd {
    display: inline-block;
    margin: 0 0.1em;
    padding: 0.1em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.72em;
    letter-spacing: 0.06em;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--dim);
    background: color-mix(in srgb, var(--card-solid) 80%, transparent);
  }

  /* Hide keyboard hint on touch devices */
  @media (pointer: coarse) {
    .section-hint {
      display: none;
    }
  }

  .grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .grid {
      gap: 0.85rem;
    }
  }
</style>
