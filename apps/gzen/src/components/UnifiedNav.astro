---
interface Props {
  activeTab?: 'home' | 'cards' | 'sanctuary' | 'game-design' | 'enlight';
}

const { activeTab = 'home' } = Astro.props;

const navItems = [
  { href: '/', label: 'Overview', kanji: '主', id: 'home' },
  { href: '/cards', label: 'Zen Cards', kanji: '卡', id: 'cards', badge: '20' },
  { href: '/game-design', label: 'Design Foundation', kanji: '道', id: 'game-design' },
  { href: '/enlight', label: 'Contemplation', kanji: '悟', id: 'enlight' },
  { href: '/sanctuary', label: '3D Sanctuary', kanji: '遊', id: 'sanctuary', isPrimary: true, isLive: true }
];
---

<header class="unified-nav" id="topNav">
  <div class="nav-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="gZen Home">
      <span class="brand-glyph" aria-hidden="true">✦</span>
      <div class="brand-text-group">
        <span class="brand-name"><span class="g-brand">g</span>Zen</span>
        <span class="brand-sub">Gaming &amp; Zen</span>
      </div>
    </a>

    <!-- Desktop Navigation Items -->
    <nav class="desktop-nav" aria-label="Desktop Navigation">
      {navItems.map(item => (
        <a 
          href={item.href}
          class:list={[
            "nav-pill",
            { 
              active: activeTab === item.id,
              'live-game-pill': item.isPrimary 
            }
          ]}
        >
          <span class="nav-kanji" aria-hidden="true">{item.kanji}</span>
          <span class="nav-label">{item.label}</span>
          {item.badge && <span class="nav-count-badge">{item.badge}</span>}
          {item.isLive && <span class="pulse-dot" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>

    <!-- Mobile Hamburger Toggle Button -->
    <div class="mobile-actions">
      <a href="/sanctuary" class="mobile-quick-enter" aria-label="Launch 3D Sanctuary">
        <span class="mobile-quick-glyph">遊</span>
        <span>3D</span>
        <span class="pulse-dot" aria-hidden="true"></span>
      </a>
      
      <button 
        type="button" 
        class="mobile-menu-toggle" 
        id="mobileMenuToggle" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileNavDrawer"
      >
        <span class="hamburger-bar top"></span>
        <span class="hamburger-bar middle"></span>
        <span class="hamburger-bar bottom"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop & Slide-down Drawer -->
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>
  <div class="mobile-nav-drawer" id="mobileNavDrawer" aria-hidden="true">
    <div class="drawer-header">
      <span class="drawer-title">Navigation · 導覽</span>
      <span class="drawer-badge">gzen.io</span>
    </div>
    <div class="drawer-links">
      {navItems.map(item => (
        <a 
          href={item.href}
          class:list={[
            "drawer-item",
            { 
              active: activeTab === item.id,
              'drawer-item-primary': item.isPrimary 
            }
          ]}
        >
          <div class="drawer-item-left">
            <span class="drawer-kanji">{item.kanji}</span>
            <span class="drawer-label">{item.label}</span>
          </div>
          <div class="drawer-item-right">
            {item.badge && <span class="drawer-count-badge">{item.badge}</span>}
            {item.isLive ? (
              <span class="pulse-dot" aria-hidden="true"></span>
            ) : (
              <span class="drawer-arrow">→</span>
            )}
          </div>
        </a>
      ))}
    </div>
    <div class="drawer-footer">
      <p class="drawer-kilo-quote">
        “Put the controller down. Not the practice.” — Still mind. Active hands.
      </p>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const drawer = document.getElementById('mobileNavDrawer');
  const backdrop = document.getElementById('mobileNavBackdrop');
  const navLinks = drawer?.querySelectorAll('a');

  let isOpen = false;

  const setOpen = (open: boolean) => {
    isOpen = open;
    toggleBtn?.setAttribute('aria-expanded', String(isOpen));
    drawer?.setAttribute('aria-hidden', String(!isOpen));
    
    if (isOpen) {
      toggleBtn?.classList.add('is-active');
      drawer?.classList.add('is-open');
      backdrop?.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // prevent background scrolling
    } else {
      toggleBtn?.classList.remove('is-active');
      drawer?.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      document.body.style.overflow = '';
    }
  };

  toggleBtn?.addEventListener('click', () => {
    setOpen(!isOpen);
  });

  backdrop?.addEventListener('click', () => {
    setOpen(false);
  });

  // Close when clicking any nav item inside drawer
  navLinks?.forEach(link => {
    link.addEventListener('click', () => {
      setOpen(false);
    });
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      setOpen(false);
    }
  });
</script>

<style>
  .unified-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    /* Warm Zen cream frosted surface matching body palette */
    background: rgba(251, 249, 245, 0.94);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid rgba(180, 83, 9, 0.12);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: background-color 0.2s ease;
  }

  .nav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Brand */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #1a1512;
    z-index: 1002;
  }

  .brand-glyph {
    color: #b45309;
    font-size: 1.15rem;
    filter: drop-shadow(0 0 6px rgba(180, 83, 9, 0.3));
    animation: gentle-rotate 12s linear infinite;
  }

  @keyframes gentle-rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .brand-text-group {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .brand-name {
    font-family: var(--font-display, sans-serif);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1a1512;
  }

  .g-brand {
    font-weight: 400;
    color: #b45309;
  }

  .brand-sub {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8c7a6b;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(180, 83, 9, 0.08);
    border: 1px solid rgba(180, 83, 9, 0.15);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    color: #4a3b32;
    font-size: 0.86rem;
    font-weight: 600;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(74, 59, 50, 0.1);
    background: rgba(255, 255, 255, 0.75);
  }

  .nav-pill:hover {
    color: #1a1512;
    background: #ffffff;
    border-color: rgba(180, 83, 9, 0.35);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(180, 83, 9, 0.08);
  }

  .nav-pill.active {
    color: #ffffff;
    background: #111111;
    border-color: #111111;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .nav-pill.active .nav-kanji {
    color: rgba(255, 255, 255, 0.85);
  }

  .nav-kanji {
    font-size: 0.82rem;
    color: #b45309;
    font-weight: 700;
  }

  .nav-count-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    padding: 1px 5px;
    border-radius: 8px;
    background: rgba(180, 83, 9, 0.12);
    color: #b45309;
    font-weight: 700;
  }

  .nav-pill.active .nav-count-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Live Game Pill Accent */
  .live-game-pill {
    background: rgba(180, 83, 9, 0.08);
    border-color: rgba(180, 83, 9, 0.3);
    color: #b45309;
  }

  .live-game-pill:hover {
    background: #b45309;
    color: #ffffff;
    border-color: #b45309;
  }

  .live-game-pill:hover .nav-kanji {
    color: #ffffff;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    margin-left: 0.2rem;
    box-shadow: 0 0 8px #22c55e;
    animation: live-pulse 2s infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  /* Mobile Actions */
  .mobile-actions {
    display: none;
    align-items: center;
    gap: 0.65rem;
    z-index: 1002;
  }

  .mobile-quick-enter {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(180, 83, 9, 0.1);
    border: 1px solid rgba(180, 83, 9, 0.3);
    font-size: 0.78rem;
    font-weight: 700;
    color: #b45309;
    text-decoration: none;
  }

  /* Modern Hamburger Button */
  .mobile-menu-toggle {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: #1a1512;
    border-radius: 2px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu-toggle.is-active .top {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .middle {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu-toggle.is-active .bottom {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Backdrop */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    background: #fafafa;
    border-bottom: 2px solid rgba(180, 83, 9, 0.2);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12);
    z-index: 1001;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.75rem;
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .mobile-nav-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    margin-bottom: 0.75rem;
  }

  .drawer-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c7a6b;
  }

  .drawer-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: #b45309;
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .drawer-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    text-decoration: none;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    color: #1a1512;
    transition: all 0.2s ease;
  }

  .drawer-item:hover, .drawer-item:active {
    background: #f4eee5;
    border-color: rgba(180, 83, 9, 0.25);
  }

  .drawer-item.active {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  .drawer-item.active .drawer-kanji {
    color: #ffffff;
  }

  .drawer-item-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .drawer-kanji {
    font-size: 1rem;
    font-weight: 700;
    color: #b45309;
    width: 20px;
    text-align: center;
  }

  .drawer-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .drawer-item-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-count-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 8px;
    background: rgba(180, 83, 9, 0.12);
    color: #b45309;
  }

  .drawer-item.active .drawer-count-badge {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .drawer-arrow {
    color: #a39589;
    font-size: 0.9rem;
  }

  .drawer-item-primary {
    background: linear-gradient(135deg, rgba(180, 83, 9, 0.08) 0%, rgba(180, 83, 9, 0.16) 100%);
    border-color: rgba(180, 83, 9, 0.25);
  }

  .drawer-footer {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    text-align: center;
  }

  .drawer-kilo-quote {
    margin: 0;
    font-size: 0.72rem;
    font-style: italic;
    color: #8c7a6b;
    line-height: 1.4;
  }

  /* Responsive Breakpoint */
  @media (max-width: 860px) {
    .desktop-nav {
      display: none;
    }
    .mobile-actions {
      display: flex;
    }
  }
</style>
