---
interface Props {
  activeTab?: 'home' | 'game';
}

const { activeTab = 'home' } = Astro.props;
---

<header class="unified-nav">
  <div class="nav-inner">
    <a href="/" class="brand-link" aria-label="gZen Home">
      <span class="brand-glyph" aria-hidden="true">✦</span>
      <span class="brand-name"><span class="g-brand">g</span>Zen</span>
      <span class="brand-sub">Gaming &amp; Zen</span>
    </a>

    <nav class="nav-links" aria-label="Primary Navigation">
      <a href="/" class:list={["nav-item", { active: activeTab === 'home' }]}>
        <span class="nav-kanji" aria-hidden="true">主</span>
        <span class="nav-label">Concept &amp; World</span>
      </a>
      <a href="/sanctuary" class:list={["nav-item", "game-pill", { active: activeTab === 'game' }]}>
        <span class="nav-kanji" aria-hidden="true">遊</span>
        <span class="nav-label">Zen 3D Game</span>
        <span class="pulse-dot" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</header>

<style>
  .unified-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    /* Warm Zen cream frosted surface matching body palette */
    background: rgba(251, 249, 245, 0.94);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid rgba(180, 83, 9, 0.12);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #1a1512;
  }

  .brand-glyph {
    color: #b45309;
    font-size: 1.1rem;
    filter: drop-shadow(0 0 6px rgba(180, 83, 9, 0.3));
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1a1512;
  }

  .g-brand {
    font-weight: 400;
    color: #b45309;
  }

  .brand-sub {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c7a6b;
    padding-left: 0.5rem;
    border-left: 1px solid rgba(180, 83, 9, 0.2);
    display: inline-block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    color: #4a3b32;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(74, 59, 50, 0.12);
    background: rgba(255, 255, 255, 0.75);
  }

  .nav-item:hover {
    color: #1a1512;
    background: #ffffff;
    border-color: rgba(180, 83, 9, 0.35);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(180, 83, 9, 0.08);
  }

  .nav-item.active {
    color: #ffffff;
    background: #b45309;
    border-color: #92400e;
    box-shadow: 0 4px 14px rgba(180, 83, 9, 0.25);
  }

  .nav-item.active .nav-kanji {
    color: rgba(255, 255, 255, 0.9);
  }

  .nav-kanji {
    font-size: 0.82rem;
    color: #b45309;
    font-weight: 600;
  }

  .game-pill {
    position: relative;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    margin-left: 0.2rem;
    box-shadow: 0 0 8px #22c55e;
    animation: live-pulse 2s infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding: 0.75rem 1rem;
    }
    .brand-sub {
      display: none;
    }
    .nav-item {
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
    }
  }
</style>
