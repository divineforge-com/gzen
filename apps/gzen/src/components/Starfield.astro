---
/** Sparse floating particles — calm energy, not visual noise */
const stars = Array.from({ length: 28 }, (_, i) => {
  const x = ((i * 53) % 97) + (i % 5) * 0.4;
  const y = ((i * 37) % 95) + (i % 4) * 0.5;
  const s = 0.5 + (i % 3) * 0.4;
  const o = 0.18 + (i % 4) * 0.1;
  const d = 6 + (i % 7) * 1.4;
  return { x, y, s, o, d };
});
---

<div class="starfield" aria-hidden="true">
  {
    stars.map((st) => (
      <span
        class="star"
        style={`left:${st.x}%;top:${st.y}%;width:${st.s}px;height:${st.s}px;--o:${st.o};--d:${st.d}s`}
      />
    ))
  }
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 80%, var(--accent));
    opacity: var(--o);
    transition: background 0.45s var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .star {
      animation: twinkle var(--d) ease-in-out infinite alternate;
    }
  }

  @keyframes twinkle {
    from {
      opacity: calc(var(--o) * 0.3);
      transform: scale(0.9);
    }
    to {
      opacity: var(--o);
      transform: scale(1);
    }
  }
</style>
