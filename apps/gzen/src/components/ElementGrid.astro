---
import { elements, site } from "../data/elements";
import ElementCard from "./ElementCard.astro";
---

<section class="elements-section" id="elements" aria-label="The Three Sovereign Elements of gZen">
  <header class="elements-head reveal">
    <div>
      <p class="eyebrow">Z · E · N // EQUILIBRIUM</p>
      <h2 class="section-title">Three elements. Perpetual balance.</h2>
      <p class="section-lead">
        <strong>Water</strong> (Somatic Stillness), <strong>Earth</strong> (Capital Foundation), and <strong>Fire</strong> (Command Ignition).
        The axis where biological vitality, immutable capital, and agentic synthesis converge.
      </p>
      <p class="section-maxim">
        {site.maxim}
      </p>
      <p class="section-hint" aria-hidden="true">
        Press <kbd>Z</kbd> <kbd>E</kbd> <kbd>N</kbd> to ignite elemental practice.
      </p>
    </div>
  </header>

  <div class="grid" id="elements-carousel">
    {elements.map((element, i) => <ElementCard element={element} index={i} />)}
  </div>

  <!-- Mobile Swipe Rail & Quick Indicator -->
  <div class="mobile-swipe-rail" role="tablist" aria-label="Mobile element pagination">
    <button type="button" class="swipe-dot dot-water active" data-swipe-target="Z" aria-label="View Water (Zen) Element">
      <span class="dot-glow" aria-hidden="true"></span>
      <span class="dot-kanji">水</span>
      <span class="dot-name">Water</span>
    </button>
    <button type="button" class="swipe-dot dot-earth" data-swipe-target="E" aria-label="View Earth (Economy) Element">
      <span class="dot-glow" aria-hidden="true"></span>
      <span class="dot-kanji">地</span>
      <span class="dot-name">Earth</span>
    </button>
    <button type="button" class="swipe-dot dot-fire" data-swipe-target="N" aria-label="View Fire (Neural) Element">
      <span class="dot-glow" aria-hidden="true"></span>
      <span class="dot-kanji">火</span>
      <span class="dot-name">Fire</span>
    </button>
  </div>
</section>

<style>
  .elements-section {
    padding: var(--space-section) 0 0;
  }

  .elements-head {
    margin-bottom: clamp(2.25rem, 5.5vw, 3.25rem);
    max-width: 44rem;
  }

  .section-lead {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.6;
    color: var(--muted);
    margin-top: 0.75rem;
  }

  .section-lead strong {
    color: var(--ink);
    font-weight: 550;
  }

  .section-maxim {
    margin: 0.85rem 0 0;
    color: var(--dim);
    font-size: 0.92rem;
    line-height: 1.6;
    font-style: italic;
  }

  .section-hint {
    margin: 0.75rem 0 0;
    color: var(--dim);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .section-hint kbd {
    display: inline-block;
    margin: 0 0.1em;
    padding: 0.12em 0.45em;
    font-family: var(--font-mono);
    font-size: 0.74em;
    letter-spacing: 0.06em;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Hide keyboard hint on touch devices */
  @media (pointer: coarse) {
    .section-hint {
      display: none;
    }
  }

  .grid {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 6.5rem);
    position: relative;
    z-index: 1;
  }

  /* Mobile Swipe Carousel Layout */
  .mobile-swipe-rail {
    display: none;
  }

  @media (max-width: 768px) {
    .grid {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 1rem;
      -webkit-overflow-scrolling: touch;
      padding: 0.5rem 0.25rem 1.25rem;
      gap: 1rem;
      scrollbar-width: none;
    }

    .grid::-webkit-scrollbar {
      display: none;
    }

    :global(.element-card) {
      flex: 0 0 calc(100vw - 3.25rem);
      max-width: 440px;
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }

    .mobile-swipe-rail {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.65rem;
      margin-top: 0.75rem;
    }

    .swipe-dot {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(255, 255, 255, 0.08);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--dim);
      cursor: pointer;
      transition: all 0.25s var(--ease);
    }

    .dot-glow {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
    }

    .dot-kanji {
      font-weight: 700;
    }

    .dot-water.active {
      color: #22d3ee;
      background: rgba(34, 211, 238, 0.12);
      border-color: rgba(34, 211, 238, 0.45);
      box-shadow: 0 0 12px rgba(34, 211, 238, 0.3);
    }

    .dot-earth.active {
      color: #fbbf24;
      background: rgba(251, 191, 36, 0.12);
      border-color: rgba(251, 191, 36, 0.45);
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.3);
    }

    .dot-fire.active {
      color: #f97316;
      background: rgba(249, 115, 22, 0.12);
      border-color: rgba(249, 115, 22, 0.45);
      box-shadow: 0 0 12px rgba(249, 115, 22, 0.3);
    }
  }
</style>
