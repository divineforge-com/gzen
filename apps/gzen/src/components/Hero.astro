---
import { site } from "../data/paths";

const m = site.themes.monastery;
const i = site.themes.ignite;
---

<header class="hero">
  <div class="hero-flow" aria-hidden="true"></div>

  <p class="eyebrow reveal">gZen · fire &amp; peace</p>

  <h1 class="wordmark reveal reveal-d1">
    <span class="g">g</span><span class="zen">Zen</span>
  </h1>

  <p class="hook reveal reveal-d2">{site.hook}</p>

  <p class="subhead reveal reveal-d2">{site.subhead}</p>

  <p class="theme-line reveal reveal-d3">
    <span class="copy-monastery">{m.tagline} · {m.lede}</span>
    <span class="copy-ignite">{i.tagline} · {i.lede}</span>
  </p>

  <div class="cta-row reveal reveal-d3">
    <a class="cta-primary" href="#paths">Enter the four paths</a>
    <a class="cta-ghost" href="#protocol">Daily protocol</a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: clamp(5.5rem, 14vw, 9rem) 0 clamp(3.5rem, 8vw, 5.5rem);
    max-width: 42rem;
    margin: 0 auto;
  }

  .hero-flow {
    position: absolute;
    left: 50%;
    top: 18%;
    width: min(28rem, 90vw);
    height: min(28rem, 90vw);
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--flow) 0%,
      transparent 68%
    );
    filter: blur(40px);
    pointer-events: none;
    z-index: -1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-flow {
      animation: flow-drift 12s var(--ease-fluid) infinite;
    }
  }

  .wordmark {
    margin: 0;
    font-size: clamp(3.6rem, 15vw, 6.75rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.92;
    color: var(--ink);
  }

  .wordmark .g {
    font-weight: 400;
    opacity: 0.88;
  }

  .wordmark .zen {
    font-weight: 560;
  }

  .hook {
    margin: clamp(1.75rem, 4vw, 2.25rem) 0 0;
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--ink);
  }

  .subhead {
    margin: 1rem auto 0;
    max-width: 28rem;
    color: var(--muted);
    font-size: clamp(0.98rem, 2.1vw, 1.08rem);
    line-height: 1.65;
  }

  .theme-line {
    margin: 1.5rem auto 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 0.35s var(--ease);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-top: 2.25rem;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.45rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      opacity 0.2s var(--ease);
  }

  .cta-primary:hover,
  .cta-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    outline: none;
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .cta-ghost:hover,
  .cta-ghost:focus-visible {
    border-color: var(--accent);
    color: var(--ink);
    background: var(--accent-soft);
    outline: none;
  }

  @media (max-width: 640px) {
    .hero {
      padding: clamp(3rem, 10vw, 5rem) 0 clamp(2rem, 5vw, 3rem);
    }

    .wordmark {
      font-size: clamp(2.75rem, 12vw, 4.5rem);
    }

    .hook {
      font-size: clamp(1.15rem, 3vw, 1.45rem);
      margin-top: 1.25rem;
    }

    .subhead {
      font-size: 0.92rem;
      max-width: 24rem;
    }

    .cta-row {
      flex-direction: column;
      gap: 0.65rem;
      margin-top: 1.75rem;
    }

    .cta-primary,
    .cta-ghost {
      width: 100%;
      justify-content: center;
      text-align: center;
      font-size: 0.88rem;
      padding: 0.8rem 1.2rem;
    }
  }
</style>
