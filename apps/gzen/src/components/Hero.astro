---
import { site } from "../data/paths";

const m = site.themes.monastery;
const i = site.themes.ignite;
---

<header class="hero">
  <div class="hero-flow" aria-hidden="true"></div>

  <p class="eyebrow reveal">gZen · fire &amp; peace</p>

  <h1 class="wordmark reveal reveal-d1">
    <span class="g">g</span><span class="zen">Zen</span>
  </h1>

  <p class="hook reveal reveal-d2">{site.hook}</p>

  <p class="subhead reveal reveal-d2">{site.subhead}</p>

  <p class="theme-line reveal reveal-d3">
    <span class="copy-monastery">{m.tagline} · {m.lede}</span>
    <span class="copy-ignite">{i.tagline} · {i.lede}</span>
  </p>

  <div class="cta-row reveal reveal-d3">
    <a class="cta-primary" href="#paths">Enter the three portals</a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: clamp(5.5rem, 14vw, 9rem) 0 clamp(3.5rem, 8vw, 5.5rem);
    max-width: 42rem;
    margin: 0 auto;
  }

  .hero-flow {
    position: absolute;
    left: 50%;
    top: 22%;
    transform: translate(-50%, -50%);
    width: clamp(260px, 48vw, 420px);
    height: clamp(260px, 48vw, 420px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--glow) 0%,
      color-mix(in srgb, var(--accent) 12%, transparent) 45%,
      transparent 70%
    );
    filter: blur(48px);
    pointer-events: none;
    z-index: -1;
    opacity: 0.85;
    transition:
      background 0.5s var(--ease),
      opacity 0.5s var(--ease);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .eyebrow::before,
  .eyebrow::after {
    content: "";
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    background: var(--line-strong);
  }

  .wordmark {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 11vw, 5.75rem);
    font-weight: 450;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--ink);
  }

  .wordmark .g {
    color: var(--accent);
    font-feature-settings: "ss01" on;
    margin-right: -0.04em;
    transition: color 0.45s var(--ease);
  }

  .wordmark .zen {
    color: var(--ink);
    transition: color 0.45s var(--ease);
  }

  .hook {
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    font-weight: 550;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 auto 0.75rem;
    max-width: 30ch;
  }

  .subhead {
    font-size: clamp(0.98rem, 2.2vw, 1.12rem);
    line-height: 1.55;
    color: var(--muted);
    margin: 0 auto 1.5rem;
    max-width: 36ch;
    font-weight: 400;
  }

  .theme-line {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--dim);
    margin: 0 auto 2.25rem;
    min-height: 1.2em;
    display: flex;
    justify-content: center;
  }

  .copy-monastery,
  .copy-ignite {
    display: none;
  }

  :global([data-theme="monastery"]) .copy-monastery {
    display: inline;
  }

  :global([data-theme="ignite"]) .copy-ignite {
    display: inline;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.6rem;
    font-size: 0.88rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: #fff;
    background: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 70%, #000);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 18px -2px color-mix(in srgb, var(--accent) 45%, transparent);
    transition:
      background 0.3s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .cta-primary:hover,
  .cta-primary:focus-visible {
    background: color-mix(in srgb, var(--accent) 88%, #fff);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -2px color-mix(in srgb, var(--accent) 55%, transparent);
    outline: none;
  }
</style>
