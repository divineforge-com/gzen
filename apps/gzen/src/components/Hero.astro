---
import { site } from "../data/elements";
---

<header class="hero">
  <div class="hero-flow" aria-hidden="true"></div>

  <p class="eyebrow reveal">{site.eyebrow}</p>

  <h1 class="wordmark reveal reveal-d1">
    <span class="chromatic-logo"><span class="g">g</span><span class="zen">Zen</span></span>
  </h1>

  <p class="hook reveal reveal-d2">{site.hook}</p>

  <p class="subhead reveal reveal-d2">{site.subhead}</p>

  <!-- Tri-Elemental Equilibrium Badges -->
  <div class="element-trinity-row reveal reveal-d3">
    <div class="tri-pill pill-water">
      <span class="pill-dot"></span>
      <span class="pill-kanji">水</span>
      <span class="pill-name">Water · Stillness</span>
    </div>
    <div class="tri-pill pill-earth">
      <span class="pill-dot"></span>
      <span class="pill-kanji">地</span>
      <span class="pill-name">Earth · Foundation</span>
    </div>
    <div class="tri-pill pill-fire">
      <span class="pill-dot"></span>
      <span class="pill-kanji">火</span>
      <span class="pill-name">Fire · Ignition</span>
    </div>
  </div>

  <div class="cta-row reveal reveal-d3">
    <a class="cta-primary" href="#elements">
      <span>{site.cta}</span>
      <svg class="cta-arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 3.5V12.5M8 12.5L4 8.5M8 12.5L12 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: clamp(5rem, 13vw, 8.5rem) 0 clamp(3.25rem, 7.5vw, 5rem);
    max-width: 44rem;
    margin: 0 auto;
  }

  .hero-flow {
    position: absolute;
    left: 50%;
    top: 24%;
    transform: translate(-50%, -50%);
    width: clamp(280px, 52vw, 460px);
    height: clamp(280px, 52vw, 460px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(34, 211, 238, 0.12) 0%,
      rgba(251, 191, 36, 0.1) 35%,
      rgba(249, 115, 22, 0.08) 60%,
      transparent 75%
    );
    filter: blur(54px);
    pointer-events: none;
    z-index: -1;
    opacity: 0.9;
    animation: flow-elemental-breath 14s ease-in-out infinite alternate;
  }

  @keyframes flow-elemental-breath {
    0% {
      transform: translate(-50%, -50%) scale(0.92);
      filter: blur(48px);
    }
    50% {
      transform: translate(-48%, -52%) scale(1.08);
      filter: blur(62px);
    }
    100% {
      transform: translate(-52%, -48%) scale(1.0);
      filter: blur(52px);
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 1.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .eyebrow::before,
  .eyebrow::after {
    content: "";
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .wordmark {
    margin: 0 0 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 12vw, 6.25rem);
    font-weight: 450;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  /* Ever-Shifting Chromatic Gradient Wordmark */
  .chromatic-logo {
    display: inline-block;
    background: linear-gradient(
      135deg,
      #22d3ee 0%,
      #38bdf8 20%,
      #fbbf24 45%,
      #f59e0b 65%,
      #f97316 85%,
      #22d3ee 100%
    );
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: chromatic-perpetual 12s ease-in-out infinite;
    filter: drop-shadow(0 0 24px rgba(34, 211, 238, 0.2));
  }

  .chromatic-logo .g {
    font-feature-settings: "ss01" on;
    margin-right: -0.04em;
  }

  @keyframes chromatic-perpetual {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .hook {
    font-size: clamp(1.25rem, 3.2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 auto 0.85rem;
    max-width: 32ch;
  }

  .subhead {
    font-size: clamp(0.98rem, 2.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--muted);
    margin: 0 auto 1.85rem;
    max-width: 40ch;
    font-weight: 400;
  }

  /* Tri-Elemental Row */
  .element-trinity-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin: 0 auto 2.5rem;
  }

  .tri-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pill-kanji {
    font-weight: 700;
    font-size: 0.82rem;
  }

  .pill-water .pill-dot { background: #22d3ee; box-shadow: 0 0 6px #22d3ee; }
  .pill-water .pill-kanji { color: #22d3ee; }
  .pill-earth .pill-dot { background: #fbbf24; box-shadow: 0 0 6px #fbbf24; }
  .pill-earth .pill-kanji { color: #fbbf24; }
  .pill-fire .pill-dot { background: #f97316; box-shadow: 0 0 6px #f97316; }
  .pill-fire .pill-kanji { color: #f97316; }

  .tri-pill:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--ink);
  }

  .cta-row {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.8rem;
    font-size: 0.9rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: #04070c;
    background: linear-gradient(135deg, #22d3ee 0%, #38bdf8 50%, #fbbf24 100%);
    border: none;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 20px -2px rgba(34, 211, 238, 0.4);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .cta-arrow {
    width: 14px;
    height: 14px;
    transition: transform 0.25s var(--ease);
  }

  .cta-primary:hover,
  .cta-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px -2px rgba(34, 211, 238, 0.6);
    outline: none;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateY(2px);
  }
</style>
