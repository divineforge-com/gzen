---
import { site } from "../data/elements";
---

<header class="hero">
  <div class="hero-flow" aria-hidden="true"></div>

  <p class="eyebrow reveal">{site.eyebrow}</p>

  <h1 class="wordmark reveal reveal-d1">
    <span class="chromatic-logo" aria-label="gZen">
      <span class="g">g</span><span class="zen">Zen</span>
    </span>
  </h1>

  <p class="hook reveal reveal-d2">{site.hook}</p>

  <p class="subhead reveal reveal-d2">{site.subhead}</p>

  <!-- Tri-Elemental Equilibrium Interactive Badges -->
  <div class="element-trinity-row reveal reveal-d3" role="navigation" aria-label="Elemental Quick Navigation">
    <a class="tri-pill pill-water" href="#element-Z" data-target="Z" aria-label="Navigate to Water (Zen) Practice">
      <span class="pill-dot" aria-hidden="true"></span>
      <span class="pill-kanji">水</span>
      <span class="pill-name">Water · Stillness</span>
    </a>
    <a class="tri-pill pill-earth" href="#element-E" data-target="E" aria-label="Navigate to Earth (Economy) Practice">
      <span class="pill-dot" aria-hidden="true"></span>
      <span class="pill-kanji">地</span>
      <span class="pill-name">Earth · Foundation</span>
    </a>
    <a class="tri-pill pill-fire" href="#element-N" data-target="N" aria-label="Navigate to Fire (Neural) Practice">
      <span class="pill-dot" aria-hidden="true"></span>
      <span class="pill-kanji">火</span>
      <span class="pill-name">Fire · Ignition</span>
    </a>
  </div>

  <div class="hero-actions reveal reveal-d3">
    <div class="cta-row">
      <a class="cta-primary" href="#elements">
        <span>{site.cta}</span>
        <svg class="cta-arrow geo-arrow-down" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <polygon points="8,13.5 13.5,8 10,8 10,2.5 6,2.5 6,8 2.5,8" fill="currentColor" stroke="currentColor" stroke-width="0.75" stroke-linejoin="round" />
        </svg>
      </a>
      <button id="audio-resonance-toggle" class="audio-toggle" type="button" aria-label="Toggle Elemental Audio Resonance" title="Toggle 432Hz / 528Hz / 741Hz Harmonic Resonance">
        <span class="audio-waves" aria-hidden="true">
          <span class="wave-bar bar-1"></span>
          <span class="wave-bar bar-2"></span>
          <span class="wave-bar bar-3"></span>
          <span class="wave-bar bar-4"></span>
        </span>
        <span class="audio-label">Resonance</span>
        <span class="audio-status" id="audio-status-indicator">Muted</span>
      </button>
      <a class="cta-gift" href="#gift" title="Jump to Open Sovereign AI Prompt & Gift" aria-label="Jump to Open Sovereign AI Prompt & Gift">
        <span class="gift-icon-box" aria-hidden="true">
          <svg class="gift-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polygon points="8,1.5 14,5.5 8,9.5 2,5.5" stroke="currentColor" stroke-width="0.8" fill="currentColor" fill-opacity="0.18" stroke-linejoin="round" />
            <polygon points="2,5.5 8,9.5 8,14.5 2,10.5" stroke="currentColor" stroke-width="0.8" fill="currentColor" fill-opacity="0.08" stroke-linejoin="round" />
            <polygon points="14,5.5 8,9.5 8,14.5 14,10.5" stroke="currentColor" stroke-width="0.8" fill="currentColor" fill-opacity="0.12" stroke-linejoin="round" />
            <polygon points="8,3.5 9.8,5.5 8,7.5 6.2,5.5" fill="#fbbf24" fill-opacity="0.9" />
          </svg>
        </span>
        <span class="gift-label">Prompt Gift</span>
        <span class="gift-badge">AI // SEED</span>
      </a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: clamp(5rem, 13vw, 8.5rem) 0 clamp(3.25rem, 7.5vw, 5rem);
    max-width: 44rem;
    margin: 0 auto;
  }

  .hero-flow {
    position: absolute;
    left: 50%;
    top: 24%;
    transform: translate(-50%, -50%);
    width: clamp(280px, 52vw, 460px);
    height: clamp(280px, 52vw, 460px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(34, 211, 238, 0.12) 0%,
      rgba(251, 191, 36, 0.1) 35%,
      rgba(249, 115, 22, 0.08) 60%,
      transparent 75%
    );
    filter: blur(54px);
    pointer-events: none;
    z-index: -1;
    opacity: 0.9;
    animation: flow-elemental-breath 14s ease-in-out infinite alternate;
  }

  @keyframes flow-elemental-breath {
    0% {
      transform: translate(-50%, -50%) scale(0.92);
      filter: blur(48px);
    }
    50% {
      transform: translate(-48%, -52%) scale(1.08);
      filter: blur(62px);
    }
    100% {
      transform: translate(-52%, -48%) scale(1.0);
      filter: blur(52px);
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 1.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .eyebrow::before,
  .eyebrow::after {
    content: "";
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .wordmark {
    margin: 0 0 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 13.5vw, 7.25rem);
    font-weight: 850;
    letter-spacing: -0.015em;
    line-height: 1.12;
    padding-bottom: 0.15em;
    overflow: visible;
  }

  /* Ever-Shifting Chromatic Gradient Wordmark — Wide, Bold, Lower-Height Ratio */
  .chromatic-logo {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    transform: scale(1.08, 0.90);
    transform-origin: center center;
    padding: 0.08em 0.22em 0.28em 0.12em;
    margin-bottom: -0.15em;
    background: linear-gradient(
      135deg,
      #22d3ee 0%,
      #38bdf8 20%,
      #fbbf24 45%,
      #f59e0b 65%,
      #f97316 85%,
      #22d3ee 100%
    );
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: chromatic-perpetual 12s ease-in-out infinite;
    filter: drop-shadow(0 0 28px rgba(34, 211, 238, 0.28));
    overflow: visible;
  }

  .chromatic-logo .g {
    font-weight: 900;
    font-feature-settings: "ss01" on;
    margin-right: -0.02em;
    transform: translateY(-0.01em);
  }

  .chromatic-logo .zen {
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  @keyframes chromatic-perpetual {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .hook {
    font-size: clamp(1.25rem, 3.2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 auto 0.85rem;
    max-width: 32ch;
  }

  .subhead {
    font-size: clamp(0.98rem, 2.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--muted);
    margin: 0 auto 1.85rem;
    max-width: 40ch;
    font-weight: 400;
  }

  /* Tri-Elemental Interactive Navigation Row */
  .element-trinity-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin: 0 auto 2.5rem;
  }

  .tri-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pill-kanji {
    font-weight: 700;
    font-size: 0.82rem;
  }

  .pill-water .pill-dot { background: #22d3ee; box-shadow: 0 0 6px #22d3ee; }
  .pill-water .pill-kanji { color: #22d3ee; }
  .pill-earth .pill-dot { background: #fbbf24; box-shadow: 0 0 6px #fbbf24; }
  .pill-earth .pill-kanji { color: #fbbf24; }
  .pill-fire .pill-dot { background: #f97316; box-shadow: 0 0 6px #f97316; }
  .pill-fire .pill-kanji { color: #f97316; }

  .tri-pill:hover,
  .tri-pill:focus-visible {
    transform: translateY(-2px) scale(1.04);
    color: var(--ink);
    outline: none;
  }

  .pill-water:hover, .pill-water:focus-visible {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.4);
    box-shadow: 0 4px 18px -2px rgba(34, 211, 238, 0.35);
  }
  .pill-earth:hover, .pill-earth:focus-visible {
    background: rgba(251, 191, 36, 0.12);
    border-color: rgba(251, 191, 36, 0.4);
    box-shadow: 0 4px 18px -2px rgba(251, 191, 36, 0.35);
  }
  .pill-fire:hover, .pill-fire:focus-visible {
    background: rgba(249, 115, 22, 0.12);
    border-color: rgba(249, 115, 22, 0.4);
    box-shadow: 0 4px 18px -2px rgba(249, 115, 22, 0.35);
  }

  .hero-actions {
    margin-top: 0.5rem;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.8rem;
    font-size: 0.9rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: #04070c;
    background: linear-gradient(135deg, #22d3ee 0%, #38bdf8 50%, #fbbf24 100%);
    border: none;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 20px -2px rgba(34, 211, 238, 0.4);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .cta-arrow {
    width: 14px;
    height: 14px;
    transition: transform 0.25s var(--ease);
  }

  .cta-primary:hover,
  .cta-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px -2px rgba(34, 211, 238, 0.6);
    outline: none;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateY(2px);
  }

  /* Web Audio Resonance Toggle */
  .audio-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.78rem 1.25rem;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    box-sizing: border-box;
    min-height: 44px;
    box-shadow: 0 2px 12px -2px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);

  .audio-toggle:hover,
  .audio-toggle:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(34, 211, 238, 0.35);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    outline: none;
  }

  .audio-waves {
    display: inline-flex;
    align-items: center;
    gap: 2.5px;
    height: 14px;
  }

  .wave-bar {
    display: inline-block;
    width: 3px;
    height: 4px;
    background: var(--dim);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    transition: background 0.3s var(--ease), height 0.3s var(--ease);
  }

  .audio-status {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--dim);
    padding: 0.12em 0.45em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease), color 0.25s var(--ease);

  .audio-toggle.active {
    background: rgba(34, 211, 238, 0.1);
    border-color: rgba(34, 211, 238, 0.45);
    color: var(--ink);
    box-shadow: 0 0 20px -2px rgba(34, 211, 238, 0.3);
  }

  .audio-toggle.active .wave-bar {
    background: #22d3ee;
    animation: wave-bounce 1.2s ease-in-out infinite alternate;
  }

  .audio-toggle.active .bar-1 { animation-delay: 0.0s; }
  .audio-toggle.active .bar-2 { animation-delay: 0.2s; }
  .audio-toggle.active .bar-3 { animation-delay: 0.4s; }
  .audio-toggle.active .bar-4 { animation-delay: 0.15s; }

  .audio-toggle.active .audio-status {
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.15);
  }

  @keyframes wave-bounce {
    0% { height: 4px; }
    100% { height: 14px; }
  }

  /* Prompt Gift Jump Button */
  .cta-gift {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.78rem 1.25rem;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    min-height: 44px;
    box-shadow: 0 2px 12px -2px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .gift-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .gift-icon {
    width: 14px;
    height: 14px;
    color: #38bdf8;
    transition: transform 0.3s var(--ease), color 0.3s var(--ease);
  }

  .gift-label {
    font-weight: 500;
    color: var(--dim);
    transition: color 0.25s var(--ease);
  }

  .gift-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: #fbbf24;
    padding: 0.12em 0.45em;
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.22);
    border-radius: 4px;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .cta-gift:hover,
  .cta-gift:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(251, 191, 36, 0.35);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    box-shadow: 0 4px 20px -2px rgba(251, 191, 36, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    outline: none;
  }

  .cta-gift:hover .gift-icon {
    transform: rotate(15deg) scale(1.1);
    color: #67e8f9;
  }

  .cta-gift:hover .gift-label {
    color: var(--ink);
  }

  .cta-gift:hover .gift-badge {
    background: rgba(251, 191, 36, 0.16);
    border-color: rgba(251, 191, 36, 0.45);
    color: #fde68a;
  }
</style>
