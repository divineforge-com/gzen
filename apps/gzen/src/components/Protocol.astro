---
import { site } from "../data/paths";

const { protocol } = site;
---

<section class="protocol" id="protocol" aria-labelledby="protocol-title">
  <div class="panel">
    <header class="head reveal">
      <p class="eyebrow">Section 03 · Actionable value</p>
      <h2 class="section-title" id="protocol-title">{protocol.title}</h2>
      <p class="section-lead">{protocol.lead}</p>
    </header>

    <ol class="steps">
      {
        protocol.steps.map((step, i) => (
          <li class:list={["step", "reveal", `reveal-d${i + 1}`]}>
            <div class="step-mark">
              <span class="step-n">{i + 1}</span>
              <span class="step-name">{step.name}</span>
            </div>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>

    <p class="hint reveal reveal-d4">
      Start with the paths — practice lives in the work, not in the signup form.
    </p>
  </div>
</section>

<style>
  .protocol {
    padding: var(--space-section) 0 0;
  }

  .panel {
    position: relative;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid var(--line);
    background:
      radial-gradient(
        80% 60% at 10% 0%,
        var(--flow),
        transparent 55%
      ),
      var(--card);
    backdrop-filter: blur(16px);
    overflow: hidden;
  }

  .head {
    max-width: 34rem;
    margin-bottom: clamp(2rem, 5vw, 2.75rem);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .step {
    display: grid;
    gap: 0.5rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .step {
      grid-template-columns: minmax(8rem, 11rem) 1fr;
      gap: 1.5rem;
      align-items: baseline;
      padding: 1.5rem 0;
    }
  }

  .step-mark {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .step-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .step-name {
    font-size: 1.15rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .hint {
    margin: 1.75rem 0 0;
    font-size: 0.88rem;
    color: var(--dim);
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .panel {
      padding: clamp(1.35rem, 3vw, 1.75rem);
    }

    .head {
      margin-bottom: 1.5rem;
    }

    .step {
      padding: 1.1rem 0;
    }

    .step-name {
      font-size: 1.05rem;
    }

    .step p {
      font-size: 0.9rem;
    }

    .hint {
      margin: 1.25rem 0 0;
      font-size: 0.82rem;
    }
  }
</style>
