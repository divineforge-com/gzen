---
interface Props {
  slotId?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal';
  responsive?: boolean;
  className?: string;
}

const {
  slotId = "8294017265",
  format = "auto",
  responsive = true,
  className = ""
} = Astro.props;

const client = "ca-pub-0491250494506886";
---

<div class={`zen-ad-wrapper ${className}`}>
  <div class="ad-label">SPONSORED CONTEMPLATION</div>
  <div class="ad-container">
    <ins
      class="adsbygoogle"
      style="display:block; text-align:center;"
      data-ad-client={client}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive={responsive ? "true" : "false"}
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
</div>

<style>
  .zen-ad-wrapper {
    margin: 40px auto;
    max-width: 960px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(220, 215, 205, 0.45);
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .ad-label {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: #a8a29e;
    text-transform: uppercase;
    margin-bottom: 8px;
    user-select: none;
  }

  .ad-container {
    min-height: 90px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
</style>
