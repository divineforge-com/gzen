---
import "../styles/global.css";
import { site } from "../data/elements";

interface Props {
  title?: string;
  description?: string;
  /** Social preview image, path under /public or absolute URL. */
  image?: string;
  imageAlt?: string;
}

const {
  title = site.title,
  description = site.description,
  image = "/assets/game-design/world-four-zones.jpg",
  imageAlt = "Low-poly concept of four sanctuary islands joined by stone paths",
} = Astro.props;
// Per-page canonical: the page's own path on the production origin (not the site root).
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Google Analytics 4 (property gzen.io, stream https://gzen.io). Not secret. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G59M34WW9Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G59M34WW9Y');
    </script>

    <meta name="theme-color" content="#fafafa" id="meta-theme-color" />
    <meta name="color-scheme" content="light" />
    <meta name="google-adsense-account" content="ca-pub-0491250494506886" />
    <!-- Google AdSense Official Script Tag -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-0491250494506886"
      crossorigin="anonymous"
    ></script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
  </head>
  <body>
    <div class="shell" id="shell">
      <slot />
    </div>
    <script>
      import "../scripts/portal.ts";
    </script>
  </body>
</html>

<style>
  .shell {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
  }
</style>
